 """Summary statistics over a set of observations."""
+import statistics
 from collections.abc import Iterable
 
 from .models import Observation
 
 MEASUREMENTS = ("wave_height_m", "water_temp_c", "wind_gust_ms", "battery_v")
 
+# Wave height is reported as a median: a single storm spike shouldn't skew
+# the "typical" sea state, unlike the other measurements which are means.
+MEDIAN_MEASUREMENTS = {"wave_height_m"}
