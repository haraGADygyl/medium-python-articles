flowchart TB
    subgraph N["Naive boundary: id up to max(id)"]
        direction LR
        N1["ids are handed out<br/>at INSERT, not COMMIT"] --> N2["fold id &lt;= max(id)<br/>into the checkpoint"]
        N2 --> N3["read = checkpoint +<br/>entries with id &gt; max(id)"]
        N3 --> N4["2,215 of 99,783 entries<br/>lost in 30 s, permanently"]
    end
    subgraph W["Watermark: xid below the snapshot's xmin"]
        direction LR
        W1["every xid below xmin<br/>has finished"] --> W2["fold xid &lt; xmin<br/>into the checkpoint"]
        W2 --> W3["read = checkpoint +<br/>entries with xid &gt;= xmin"]
        W3 --> W4["0 lost<br/>of 83,886"]
    end
    N ~~~ W
    classDef ok fill:#d4edda,stroke:#2f7a45,stroke-width:2px,color:#14401f
    classDef bad fill:#f8d7da,stroke:#a33a43,stroke-width:2px,color:#5c1a20
    class W4 ok
    class N4 bad
