flowchart TB
    start@{ shape: sm-circ }
    start -- "connect<br/>HSET + SADD" --> online(["Online"])
    online -- "ping unanswered" --> missed(["Missed one ping"])
    missed -- "PONG" --> online
    missed -- "second miss<br/>10.1–15.0 s after vanishing" --> offline(["Offline"])
    online -- "socket closed<br/>2.3 ms" --> offline
    online -- "gateway lease expired<br/>2.16 s, all its users at once" --> offline
    offline -. "reconnect to any gateway" .-> online
    classDef ok fill:#d4edda,stroke:#2f7a45,stroke-width:2px,color:#14401f
    classDef warn fill:#fff3cd,stroke:#a07a10,stroke-width:2px,color:#4d3a05
    classDef bad fill:#f8d7da,stroke:#a33a43,stroke-width:2px,color:#5c1a20
    class online ok
    class missed warn
    class offline bad
