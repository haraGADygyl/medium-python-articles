gantt
    title One lost beat and one late beat, seen through two windows
    dateFormat HH:mm:ss
    axisFormat %M:%S
    tickInterval 30second
    section Heartbeats
    arrives                     :milestone, b1, 00:00:00, 0s
    arrives                     :milestone, b2, 00:00:30, 0s
    lost on the way             :crit, milestone, b3, 00:01:00, 0s
    late by 14 s                :active, b4, 00:01:30, 00:01:44
    section 36 s window
    online                      :done, w1, 00:00:00, 00:01:06
    shown offline 38 s          :crit, w2, 00:01:06, 00:01:44
    online again                :done, w3, 00:01:44, 00:02:20
    section 90 s window
    online throughout           :done, w4, 00:00:00, 00:02:20
