flowchart TB
    start@{ shape: sm-circ }
    stop@{ shape: fr-circ }
    start --> free(["free"])
    free -- "added to a cart" --> held(["held"])
    held -- "checkout completes" --> sold(["sold"])
    held -- "held_until passes" --> free
    free -- "direct purchase" --> sold
    sold --> stop
    held -.- n1["Nothing performs this<br/>transition. The claim<br/>query must treat an<br/>expired hold as free."]
    classDef ok fill:#d4edda,stroke:#2f7a45,stroke-width:2px,color:#14401f
    classDef warn fill:#fff3cd,stroke:#a07a10,stroke-width:2px,color:#4d3a05
    classDef note fill:#fff8e1,stroke:#d9b44a,color:#4d3a05
    class sold ok
    class held warn
    class n1 note
