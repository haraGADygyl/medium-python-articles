+import dataclasses
+from math import pi
+
+import pytest
+
+from trailhead.plan import split_days
+from trailhead.report import Summary, format_summary, summarise
+from trailhead.track import parse_track
+
+# One degree of arc on a sphere of radius 6371.0088 km, the README's Earth.
+KM_PER_DEGREE = 2 * pi * 6371.0088 / 360
+
+
+def degrees(km: float) -> float:
+    """Degrees of longitude along the equator (or of latitude) spanning ``km``."""
+    return km / KM_PER_DEGREE
+
+
+def make_summary(**overrides: object) -> Summary:
+    values: dict[str, object] = {
+        "name": "Ridge",
+        "length_km": 12.3,
+        "gain_m": 845.0,
+        "loss_m": 790.0,
+        "highest_m": 2925.0,
+        "lowest_m": 2140.0,
+        "steepest_pct": 18.0,
+        "hours": 5 + 7 / 60,
+        "heading": "NE",
+    }
+    values.update(overrides)
+    return Summary(**values)  # type: ignore[arg-type]
+
+
+# --- summarise: fields -----------------------------------------------------------
+
+
+def test_name_comes_from_the_track(make_track):
+    track = make_track((0, 0, 0), (0, degrees(1), 0), name="Seven Rila Lakes")
+    assert summarise(track).name == "Seven Rila Lakes"
+
+
+def test_length_is_great_circle_distance_rounded_to_a_tenth(make_track):
+    # Three legs of 1.04 km each: 3.12 km in total.
+    track = make_track(*[(0, degrees(1.04) * index, 0) for index in range(4)])
+    assert summarise(track).length_km == 3.1
+
+
+def test_length_along_a_meridian(make_track):
+    track = make_track((10, 20, 0), (10 + degrees(7.26), 20, 0))
+    assert summarise(track).length_km == 7.3
+
+
+def test_ascent_and_descent(make_track):
+    step = degrees(0.5)
+    track = make_track((0, 0, 1000), (0, step, 1200), (0, 2 * step, 1150), (0, 3 * step, 1180))
+    summary = summarise(track)
+    assert summary.gain_m == 230.0
+    assert summary.loss_m == 50.0
+
+
+def test_jitter_below_the_default_threshold_is_ignored(make_track):
+    step = degrees(0.1)
+    elevations = [500, 501, 499, 501, 500, 502, 500]
+    track = make_track(*[(0, step * index, ele) for index, ele in enumerate(elevations)])
+    summary = summarise(track)
+    assert (summary.gain_m, summary.loss_m) == (0.0, 0.0)
+
+
+def test_climb_in_small_steps_counts_in_full(make_track):
+    step = degrees(0.01)
+    track = make_track(*[(0, step * index, 1000 + index) for index in range(301)])
+    assert summarise(track).gain_m == 300.0
+
+
+def test_ascent_is_rounded_to_a_tenth(make_track):
+    step = degrees(0.1)
+    track = make_track((0, 0, 100), (0, step, 103.04), (0, 2 * step, 106.08))
+    assert summarise(track).gain_m == 6.1
+
+
+def test_custom_threshold(make_track):
+    step = degrees(0.1)
+    track = make_track((0, 0, 100), (0, step, 104), (0, 2 * step, 100))
+    assert (summarise(track).gain_m, summarise(track).loss_m) == (4.0, 4.0)
+    assert (summarise(track, threshold=5).gain_m, summarise(track, threshold=5).loss_m) == (
+        0.0,
+        0.0,
+    )
+
+
+def test_negative_threshold_is_an_error(make_track):
+    track = make_track((0, 0, 0), (0, degrees(1), 10))
+    with pytest.raises(ValueError):
+        summarise(track, threshold=-1)
+
+
+def test_highest_and_lowest(make_track):
+    step = degrees(0.5)
+    track = make_track((0, 0, 1500), (0, step, 2925), (0, 2 * step, 1320), (0, 3 * step, 1800))
+    summary = summarise(track)
+    assert summary.highest_m == 2925
+    assert summary.lowest_m == 1320
+
+
+def test_steepest_grade_in_percent(make_track):
+    # A leg climbing 18 m over 100 m is 18.0, as in the README.
+    step = degrees(0.1)
+    track = make_track((0, 0, 1000), (0, step, 1018), (0, 2 * step, 1020))
+    assert summarise(track).steepest_pct == pytest.approx(18.0)
+
+
+def test_steepest_grade_counts_downhill(make_track):
+    step = degrees(0.1)
+    track = make_track((0, 0, 1000), (0, step, 1005), (0, 2 * step, 980))
+    assert summarise(track).steepest_pct == pytest.approx(25.0)
+
+
+def test_steepest_grade_skips_repeated_points(make_track):
+    step = degrees(0.1)
+    track = make_track((0, 0, 1000), (0, step, 1010), (0, step, 1050), (0, 2 * step, 1055))
+    assert summarise(track).steepest_pct == pytest.approx(10.0)
+
+
+# --- summarise: walking time -----------------------------------------------------
+
+
+def test_flat_walking_time_is_five_km_an_hour(make_track):
+    track = make_track((0, 0, 0), (0, degrees(10), 0))
+    assert summarise(track).hours == pytest.approx(2.0)
+
+
+def test_each_600_m_of_ascent_adds_an_hour(make_track):
+    track = make_track((0, 0, 0), (0, degrees(5), 300), (0, degrees(10), 600))
+    assert summarise(track).hours == pytest.approx(3.0)
+
+
+def test_descent_adds_no_time(make_track):
+    track = make_track((0, 0, 600), (0, degrees(10), 0))
+    assert summarise(track).hours == pytest.approx(2.0)
+
+
+def test_fitness_divides_the_time(make_track):
+    track = make_track((0, 0, 0), (0, degrees(5), 300), (0, degrees(10), 600))
+    assert summarise(track, fitness=1.25).hours == pytest.approx(3.0 / 1.25)
+    assert summarise(track, fitness=0.8).hours == pytest.approx(3.0 / 0.8)
+
+
+@pytest.mark.parametrize("fitness", [0, -1.0])
+def test_fitness_must_be_positive(make_track, fitness):
+    track = make_track((0, 0, 0), (0, degrees(1), 0))
+    with pytest.raises(ValueError):
+        summarise(track, fitness=fitness)
+
+
+def test_time_is_not_rounded(make_track):
+    # 1.04 km is shown as 1.0 km, but the time is worked out from the real distance.
+    track = make_track((0, 0, 0), (0, degrees(1.04), 0))
+    summary = summarise(track)
+    assert summary.length_km == 1.0
+    assert summary.hours == pytest.approx(1.04 / 5)
+
+
+def test_time_matches_the_day_plan(make_track):
+    # The days of a plan add up to the summary time for the same track and fitness.
+    step = degrees(0.7)
+    elevations = [1000, 1001, 1004, 1150, 1149, 1300, 1250, 1252, 1500, 1490, 1200]
+    track = make_track(*[(0, step * index, ele) for index, ele in enumerate(elevations)])
+    for fitness in (1.0, 1.3):
+        days = split_days(track, 0.5, fitness)
+        assert len(days) > 1
+        planned = sum(hours for *_, hours in days)
+        # Each day's hours are rounded to 0.01.
+        assert summarise(track, fitness).hours == pytest.approx(planned, abs=0.005 * len(days))
+        whole_day = split_days(track, 100, fitness)
+        assert whole_day[0][3] == round(summarise(track, fitness).hours, 2)
+
+
+# --- summarise: heading ----------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("finish", "heading"),
+    [
+        ((1, 0), "N"),
+        ((1, 1), "NE"),
+        ((0, 1), "E"),
+        ((-1, 1), "SE"),
+        ((-1, 0), "S"),
+        ((-1, -1), "SW"),
+        ((0, -1), "W"),
+        ((1, -1), "NW"),
+    ],
+)
+def test_heading_is_compass_point_from_start_to_finish(make_track, finish, heading):
+    lat, lon = finish
+    track = make_track((0, 0, 0), (0.3, 0.3, 0), (lat, lon, 0))
+    assert summarise(track).heading == heading
+
+
+def test_heading_ignores_the_route_in_between(make_track):
+    # Wander west and south, but finish due north of the start.
+    track = make_track((0, 0, 0), (-0.5, -0.5, 0), (0.5, -0.5, 0), (1, 0, 0))
+    assert summarise(track).heading == "N"
+
+
+def test_finish_near_the_start_is_a_loop(make_track):
+    track = make_track((0, 0, 0), (0, degrees(3), 100), (0, degrees(0.09), 0))
+    assert summarise(track).heading == "loop"
+
+
+def test_finish_back_at_the_start_is_a_loop(make_track):
+    track = make_track((42.2, 23.3, 2140), (42.25, 23.35, 2500), (42.2, 23.3, 2140))
+    assert summarise(track).heading == "loop"
+
+
+def test_finish_just_beyond_the_loop_radius_has_a_heading(make_track):
+    track = make_track((0, 0, 0), (0, degrees(3), 100), (0, degrees(0.11), 0))
+    assert summarise(track).heading == "E"
+
+
+def test_summary_is_immutable(make_track):
+    summary = summarise(make_track((0, 0, 0), (0, degrees(1), 0)))
+    with pytest.raises(dataclasses.FrozenInstanceError):
+        summary.name = "other"  # type: ignore[misc]
+
+
+# --- summarise from a parsed track -----------------------------------------------
+
+
+def test_elevations_in_feet_are_summarised_in_metres():
+    step = degrees(1)
+    text = f"# units: ft\nlat,lon,ele\n0,0,1000\n0,{step},2000\n0,{2 * step},1500\n# name: Feet\n"
+    summary = summarise(parse_track(text))
+    assert summary.name == "Feet"
+    assert summary.gain_m == pytest.approx(304.8)
+    assert summary.loss_m == pytest.approx(152.4)
+    assert summary.highest_m == pytest.approx(609.6)
+    assert summary.lowest_m == pytest.approx(304.8)
+    assert summary.hours == pytest.approx(2 / 5 + 304.8 / 600)
+
+
+# --- format_summary --------------------------------------------------------------
+
+
+def test_format_summary_layout():
+    assert format_summary(make_summary()) == (
+        "Ridge\n"
+        "  distance  12.3 km\n"
+        "  ascent    +845 m / -790 m\n"
+        "  altitude  2140-2925 m\n"
+        "  steepest  18.0%\n"
+        "  time      5h 07m\n"
+        "  heading   NE"
+    )
+
+
+@pytest.mark.parametrize(
+    ("hours", "shown"),
+    [
+        (5 + 7 / 60, "5h 07m"),
+        (0.75, "0h 45m"),
+        (12.0, "12h 00m"),
+        (0.0, "0h 00m"),
+        (1 + 4.4 / 60, "1h 04m"),
+        (1 + 4.6 / 60, "1h 05m"),
+        (2 + 59.6 / 60, "3h 00m"),
+        (6.07, "6h 04m"),
+    ],
+)
+def test_durations_are_rounded_to_the_nearest_minute(hours, shown):
+    lines = format_summary(make_summary(hours=hours)).splitlines()
+    assert lines[5] == f"  time      {shown}"
+
+
+def test_format_summary_shows_a_loop():
+    assert format_summary(make_summary(heading="loop")).endswith("  heading   loop")
+
+
+def test_format_summary_rounds_numbers_for_display():
+    text = format_summary(
+        make_summary(
+            length_km=3.0,
+            gain_m=12.6,
+            loss_m=0.4,
+            lowest_m=99.6,
+            highest_m=101.7,
+            steepest_pct=7.0,
+        )
+    )
+    lines = text.splitlines()
+    assert lines[1] == "  distance  3.0 km"
+    assert lines[2] == "  ascent    +13 m / -0 m"
+    assert lines[3] == "  altitude  100-102 m"
+    assert lines[4] == "  steepest  7.0%"
+
+
+def test_summary_of_a_track_end_to_end():
+    text = "# name: Ridge\nlat,lon,ele\n0,0,1000\n0,0.01,1090\n0,0.02,1050\n"
+    assert format_summary(summarise(parse_track(text))) == (
+        "Ridge\n"
+        "  distance  2.2 km\n"
+        "  ascent    +90 m / -40 m\n"
+        "  altitude  1000-1090 m\n"
+        "  steepest  8.1%\n"
+        "  time      0h 36m\n"
+        "  heading   E"
+    )
