+def test_byte_order_mark_and_crlf_are_accepted(write_track):
+    path = write_track("\ufefflat,lon,ele\r\n0,0,10\r\n0,0.01,20\r\n")
+    assert [point.ele for point in load_track(path).points] == [10, 20]
+
+
+def test_byte_order_mark_before_a_comment_line():
+    assert parse_track("\ufeff# name: Musala\nlat,lon,ele\n0,0,0\n0,0.01,0\n").name == "Musala"
+
