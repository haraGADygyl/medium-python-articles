+from math import exp
+
+import pytest
+
+from trailhead.elevation import gain_and_loss
+from trailhead.pace import leg_hours, naismith_hours, tobler_kmh
+
+# One kilometre along the equator, in degrees of longitude (radius 6371.0088 km).
+KM = 1 / 111.19508
+
+
+# --- naismith_hours ---------------------------------------------------------
+
+
+def test_flat_walking_is_five_km_per_hour():
+    assert naismith_hours(5, 0) == pytest.approx(1.0)
+    assert naismith_hours(12.5, 0) == pytest.approx(2.5)
+
+
+def test_every_600_m_of_ascent_adds_an_hour():
+    assert naismith_hours(0, 600) == pytest.approx(1.0)
+    assert naismith_hours(0, 150) == pytest.approx(0.25)
+
+
+def test_distance_and_ascent_add_up():
+    assert naismith_hours(10, 900) == pytest.approx(3.5)
+
+
+def test_nothing_to_walk_takes_no_time():
+    assert naismith_hours(0, 0) == 0
+
+
+def test_fitness_defaults_to_an_average_walker():
+    assert naismith_hours(10, 900) == naismith_hours(10, 900, fitness=1.0)
+
+
+def test_fitness_divides_the_time():
+    assert naismith_hours(10, 900, fitness=1.25) == pytest.approx(3.5 / 1.25)
+    assert naismith_hours(10, 900, fitness=2) == pytest.approx(1.75)
+
+
+def test_fitness_below_one_is_slower():
+    assert naismith_hours(10, 900, fitness=0.8) == pytest.approx(3.5 / 0.8)
+    assert naismith_hours(10, 900, fitness=0.8) > naismith_hours(10, 900)
+
+
+def test_time_is_not_rounded():
+    # 1 km is 12 minutes, 1 m of ascent is 6 seconds: neither is a round number of hours.
+    assert naismith_hours(1, 1) == pytest.approx(1 / 5 + 1 / 600, rel=1e-12)
+    assert naismith_hours(7, 0, fitness=3) == pytest.approx(7 / 15, rel=1e-12)
+
+
+@pytest.mark.parametrize("fitness", [0, -1, -0.001])
+def test_zero_or_negative_fitness_is_rejected(fitness):
+    with pytest.raises(ValueError):
+        naismith_hours(10, 100, fitness)
+
+
+@pytest.mark.parametrize(("distance_km", "ascent_m"), [(-1, 0), (0, -1), (-0.001, 500), (5, -0.1)])
+def test_negative_distance_or_ascent_is_rejected(distance_km, ascent_m):
+    with pytest.raises(ValueError):
+        naismith_hours(distance_km, ascent_m)
+
+
+# --- tobler_kmh -------------------------------------------------------------
+
+
+def test_tobler_on_the_flat():
+    assert tobler_kmh(0) == pytest.approx(6 * exp(-3.5 * 0.05))
+    assert tobler_kmh(0) == pytest.approx(5.0368, abs=1e-4)
+
+
+def test_tobler_is_fastest_on_a_gentle_descent():
+    assert tobler_kmh(-0.05) == pytest.approx(6.0)
+    for grade in (-1, -0.3, -0.1, -0.06, -0.04, 0, 0.05, 0.3, 1):
+        assert tobler_kmh(grade) < 6.0
+
+
+@pytest.mark.parametrize(
+    ("grade", "expected"),
+    [
+        (0.1, 6 * exp(-3.5 * 0.15)),
+        (-0.1, 6 * exp(-3.5 * 0.05)),
+        (0.25, 6 * exp(-3.5 * 0.30)),
+        (-0.25, 6 * exp(-3.5 * 0.20)),
+        (1.0, 6 * exp(-3.5 * 1.05)),
+    ],
+)
+def test_tobler_formula(grade, expected):
+    assert tobler_kmh(grade) == pytest.approx(expected)
+
+
+def test_tobler_grade_is_rise_over_run_not_percent():
+    # A 10% climb is grade 0.1: about 3.55 km/h.
+    assert tobler_kmh(0.1) == pytest.approx(3.549, abs=1e-3)
+
+
+def test_tobler_is_symmetric_about_the_five_percent_descent():
+    assert tobler_kmh(-0.05 + 0.2) == pytest.approx(tobler_kmh(-0.05 - 0.2))
+    assert tobler_kmh(0) == pytest.approx(tobler_kmh(-0.1))
+
+
+def test_tobler_uphill_is_slower_than_the_same_grade_downhill():
+    assert tobler_kmh(0.2) < tobler_kmh(-0.2)
+
+
+def test_tobler_slows_as_the_slope_steepens():
+    climbs = [tobler_kmh(grade) for grade in (0, 0.1, 0.2, 0.4, 0.8)]
+    descents = [tobler_kmh(grade) for grade in (-0.05, -0.1, -0.2, -0.4, -0.8)]
+    assert climbs == sorted(climbs, reverse=True)
+    assert descents == sorted(descents, reverse=True)
+    assert tobler_kmh(5) > 0
+
+
+# --- leg_hours --------------------------------------------------------------
+
+
+def test_one_time_per_leg(make_track):
+    track = make_track((0, 0, 0), (0, KM, 0), (0, 2 * KM, 0), (0, 3 * KM, 0))
+    assert len(leg_hours(track)) == 3
+    assert len(leg_hours(make_track((0, 0, 0), (0, KM, 0)))) == 1
+
+
+def test_flat_legs_are_timed_by_their_length(make_track):
+    track = make_track((0, 0, 0), (0, 5 * KM, 0), (0, 7.5 * KM, 0))
+    assert leg_hours(track) == pytest.approx([1.0, 0.5], rel=1e-6)
+
+
+def test_a_climbing_leg_adds_an_hour_per_600_m(make_track):
+    track = make_track((0, 0, 1000), (0, 5 * KM, 1600), (0, 10 * KM, 1900))
+    assert leg_hours(track) == pytest.approx([2.0, 1.5], rel=1e-6)
+
+
+def test_descent_adds_nothing(make_track):
+    track = make_track((0, 0, 1600), (0, 5 * KM, 1000), (0, 10 * KM, 400))
+    assert leg_hours(track) == pytest.approx([1.0, 1.0], rel=1e-6)
+
+
+def test_climb_after_a_descent_counts_only_the_climb(make_track):
+    track = make_track((0, 0, 1000), (0, 5 * KM, 700), (0, 10 * KM, 1000))
+    assert leg_hours(track) == pytest.approx([1.0, 1.5], rel=1e-6)
+
+
+def test_zero_length_leg_takes_only_its_climb(make_track):
+    track = make_track((0, 0, 0), (0, 0, 0), (0, 0, 300))
+    assert leg_hours(track) == pytest.approx([0.0, 0.5])
+
+
+def test_jitter_below_the_threshold_adds_no_climb(make_track):
+    track = make_track((0, 0, 500), (0, 5 * KM, 502), (0, 10 * KM, 500), (0, 15 * KM, 502.9))
+    assert leg_hours(track) == pytest.approx([1.0, 1.0, 1.0], rel=1e-6)
+
+
+def test_small_steps_are_credited_to_the_leg_that_reaches_the_threshold(make_track):
+    # 1 m steps: the third leg takes the elevation 3 m above the start and gets all 3 m.
+    track = make_track(*[(0, index * 5 * KM, 100 + index) for index in range(5)])
+    assert leg_hours(track) == pytest.approx([1.0, 1.0, 1.0 + 3 / 600, 1.0], rel=1e-6)
+
+
+def test_a_climb_of_exactly_the_threshold_counts(make_track):
+    track = make_track((0, 0, 100), (0, 5 * KM, 103))
+    assert leg_hours(track) == pytest.approx([1.0 + 3 / 600], rel=1e-6)
+
+
+def test_leg_fitness_divides_every_leg(make_track):
+    track = make_track((0, 0, 1000), (0, 5 * KM, 1600), (0, 10 * KM, 1300), (0, 12 * KM, 1300))
+    average = leg_hours(track)
+    assert leg_hours(track, fitness=1.25) == pytest.approx([hours / 1.25 for hours in average])
+    assert leg_hours(track, fitness=0.8) == pytest.approx([hours / 0.8 for hours in average])
+    assert leg_hours(track, 1.0) == average
+
+
+@pytest.mark.parametrize("fitness", [0, -1])
+def test_leg_fitness_must_be_positive(make_track, fitness):
+    with pytest.raises(ValueError):
+        leg_hours(make_track((0, 0, 0), (0, KM, 0)), fitness)
+
+
+@pytest.mark.parametrize("fitness", [1.0, 1.2, 0.75])
+def test_legs_add_up_to_the_summary_time(make_track, fitness):
+    elevations = [2140, 2141, 2196, 2194.5, 2250, 2251, 2252, 2253, 2100, 2101.5, 2330, 2329]
+    track = make_track(
+        *[(42.2 + index * 0.004, 23.3 - index * 0.003, ele) for index, ele in enumerate(elevations)]
+    )
+    gain, _ = gain_and_loss([point.ele for point in track.points])
+    summary = naismith_hours(track.length_km(), gain, fitness)
+    assert sum(leg_hours(track, fitness)) == pytest.approx(summary, abs=1e-3)
