+def test_long_climb_in_small_steps_is_counted():
+    # One point per metre, 300 m up: each step is below the threshold on its own.
+    assert gain_and_loss([100 + i for i in range(301)]) == (300.0, 0.0)
+    # The same 300 m climb, then 300 m back down in 1 m steps.
+    up = [100 + i for i in range(301)]
+    down = [400 - i for i in range(1, 301)]
+    assert gain_and_loss(up + down) == (300.0, 300.0)
+
+
 def test_jitter_below_the_threshold_is_ignored():
