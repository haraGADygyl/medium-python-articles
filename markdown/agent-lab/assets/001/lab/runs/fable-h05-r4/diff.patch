+@pytest.mark.parametrize("fitness", [1.0, 1.25])
+def test_days_add_up_to_the_summary_time_on_a_noisy_track(make_track, fitness):
+    # A gentle climb with 2 m of up-and-down jitter on every other point.
+    step = 1 / 111.19508
+    track = make_track(
+        *[(0, index * step, 1000 + index * 0.25 + (2 if index % 2 else 0)) for index in range(81)]
+    )
+    days = split_days(track, max_hours_per_day=6, fitness=fitness)
+    assert len(days) > 1
+    total = sum(hours for *_, hours in days)
+    assert total == pytest.approx(summarise(track, fitness).hours, abs=0.01 * len(days))
+
+
 def test_invalid_limit(five_flat_hours):
     with pytest.raises(ValueError):
         split_days(five_flat_hours, max_hours_per_day=0)
