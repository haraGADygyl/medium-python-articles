diff --git a/tests/test_cli.py b/tests/test_cli.py
index a4bd93f..e94e248 100644
--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -1,3 +1,5 @@
+import pytest
+
 from trailhead.cli import main
 
 TRACK = "# name: Ridge\nlat,lon,ele\n0,0,1000\n0,0.01,1090\n0,0.02,1050\n"
@@ -18,3 +20,25 @@ def test_plan_command(write_track, capsys):
 def test_missing_file_is_an_error(tmp_path, capsys):
     assert main(["summary", str(tmp_path / "nope.csv")]) == 1
     assert capsys.readouterr().err.startswith("trailhead: ")
+
+
+def test_summary_pace_option(write_track, capsys):
+    path = str(write_track(TRACK))
+    assert main(["summary", path]) == 0
+    naismith = capsys.readouterr().out
+    assert main(["summary", path, "--pace", "tobler"]) == 0
+    tobler = capsys.readouterr().out
+    assert tobler.startswith("Ridge\n") and tobler != naismith
+    assert "  time      " in tobler
+
+
+def test_plan_pace_option(write_track, capsys):
+    assert main(["plan", str(write_track(TRACK)), "--pace", "tobler"]) == 0
+    assert capsys.readouterr().out.startswith("Day 1: points 0-2, ")
+
+
+def test_pace_must_be_a_known_choice(write_track, capsys):
+    with pytest.raises(SystemExit) as exc:
