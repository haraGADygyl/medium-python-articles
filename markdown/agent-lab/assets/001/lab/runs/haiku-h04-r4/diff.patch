+def format_duration(hours: float) -> str:
+    """Display hours as ``<hours>h <minutes>m``, rounded to the nearest minute.
+
+    Rounds the total first, so 59.6 minutes becomes ``1h 00m``, not ``0h 60m``.
+    """
+    total_minutes = floor(hours * 60 + 0.5)
+    whole, minutes = divmod(total_minutes, 60)
+    return f"{whole}h {minutes:02d}m"
+
