+def format_duration(hours: float) -> str:
+    """``<hours>h <minutes>m`` rounded to the nearest minute, halves rounding up.
+
+    0.7483 hours (44.9 minutes) is ``0h 45m``; 0.999 hours is ``1h 00m``.
+    """
+    whole, minutes = divmod(floor(hours * 60 + 0.5), 60)
+    return f"{whole}h {minutes:02d}m"
+
+
