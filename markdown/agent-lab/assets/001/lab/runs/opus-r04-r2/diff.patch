diff --git a/src/trailhead/track.py b/src/trailhead/track.py
index e147dce..cd76854 100644
--- a/src/trailhead/track.py
+++ b/src/trailhead/track.py
@@ -25,10 +25,20 @@ class Point:
 class Track:
     name: str
     points: list[Point] = field(default_factory=list)
+    # (points the lengths were computed from, the lengths). ``points`` is a
+    # public, mutable list, so the cache is only reused while it still matches.
+    _legs_cache: tuple[tuple[Point, ...], tuple[float, ...]] | None = field(
+        default=None, init=False, repr=False, compare=False
+    )
 
     def leg_lengths_km(self) -> list[float]:
         """Length of each leg, the stretch between two consecutive points."""
-        return [haversine_km(a.lat, a.lon, b.lat, b.lon) for a, b in pairwise(self.points)]
+        snapshot = tuple(self.points)
+        cache = self._legs_cache
+        if cache is None or cache[0] != snapshot:
+            legs = tuple(haversine_km(a.lat, a.lon, b.lat, b.lon) for a, b in pairwise(snapshot))
+            cache = self._legs_cache = (snapshot, legs)
+        return list(cache[1])
 
     def length_km(self) -> float:
         return sum(self.leg_lengths_km())
