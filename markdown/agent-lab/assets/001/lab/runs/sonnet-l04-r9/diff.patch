-from trailhead.track import Track
+from trailhead.track import Track, TrackError
 
 DEFAULT_THRESHOLD_M = 3.0
 
 
+def filled_elevations(track: Track) -> list[float]:
+    """Elevation of every point in metres, filling the gaps where the GPS lost it.
+
+    A point without elevation takes that of the nearest earlier point that has one or,
+    if there is none, of the nearest later point.
+    """
+    known = [point.ele for point in track.points if point.ele is not None]
+    if not known:
+        raise TrackError("a track needs at least one elevation")
+    filled: list[float] = []
+    last = known[0]
+    for point in track.points:
+        if point.ele is not None:
+            last = point.ele
+        filled.append(last)
+    return filled
+
+
 def counted_changes(
     elevations: Sequence[float], threshold: float = DEFAULT_THRESHOLD_M
 ) -> list[float]:
