+from math import exp
+
+import pytest
+
+from trailhead.elevation import gain_and_loss
+from trailhead.pace import leg_hours, naismith_hours, tobler_kmh
+
+# One leg of 5 km along the equator.
+STEP = 5 / 111.19508
+
+
+def equator(make_track, *elevations):
+    return make_track(*[(0, index * STEP, ele) for index, ele in enumerate(elevations)])
+
+
+# --- naismith_hours ---
+
+
+def test_naismith_flat_five_km_is_one_hour():
+    assert naismith_hours(5, 0) == pytest.approx(1.0)
+
+
+def test_naismith_600_m_of_ascent_is_one_hour():
+    assert naismith_hours(0, 600) == pytest.approx(1.0)
+
+
+def test_naismith_adds_flat_and_climb():
+    assert naismith_hours(10, 300) == pytest.approx(2.5)
+
+
+def test_naismith_zero_is_zero():
+    assert naismith_hours(0, 0) == 0
+
+
+def test_naismith_fitness_divides_time():
+    assert naismith_hours(10, 600, fitness=1.25) == pytest.approx(3.0 / 1.25)
+    assert naismith_hours(10, 600, fitness=0.8) == pytest.approx(3.0 / 0.8)
+
+
+def test_naismith_default_fitness_is_one():
+    assert naismith_hours(7, 200) == naismith_hours(7, 200, fitness=1.0)
+
+
+def test_naismith_is_not_rounded():
+    assert naismith_hours(1, 1) == pytest.approx(1 / 5 + 1 / 600, abs=1e-15)
+
+
+@pytest.mark.parametrize("fitness", [0, -1, -0.5])
+def test_naismith_rejects_non_positive_fitness(fitness):
+    with pytest.raises(ValueError):
+        naismith_hours(5, 100, fitness=fitness)
+
+
+def test_naismith_rejects_negative_distance():
+    with pytest.raises(ValueError):
+        naismith_hours(-1, 0)
+
+
+def test_naismith_rejects_negative_ascent():
+    with pytest.raises(ValueError):
+        naismith_hours(5, -1)
+
+
+# --- tobler_kmh ---
+
+
+def test_tobler_peaks_at_six_kmh_on_five_percent_descent():
+    assert tobler_kmh(-0.05) == pytest.approx(6.0)
+
+
+def test_tobler_matches_formula():
+    for grade in (-0.3, -0.1, 0.0, 0.1, 0.25):
+        assert tobler_kmh(grade) == pytest.approx(6 * exp(-3.5 * abs(grade + 0.05)))
+
+
+def test_tobler_flat_speed():
+    assert tobler_kmh(0.0) == pytest.approx(6 * exp(-0.175))
+
+
+def test_tobler_is_symmetric_around_minus_five_percent():
+    assert tobler_kmh(0.05) == pytest.approx(tobler_kmh(-0.15))
+
+
+def test_tobler_climb_is_slower_than_equal_descent():
+    assert tobler_kmh(0.1) < tobler_kmh(-0.1)
+
+
+def test_tobler_never_exceeds_six():
+    assert all(tobler_kmh(g / 100) <= 6.0 for g in range(-60, 61))
+
+
+# --- leg_hours ---
+
+
+def test_leg_hours_one_value_per_leg(make_track):
+    track = equator(make_track, 0, 0, 0, 0)
+    assert len(leg_hours(track)) == 3
+
+
+def test_leg_hours_flat_legs(make_track):
+    track = equator(make_track, 0, 0, 0)
+    assert leg_hours(track) == pytest.approx([1.0, 1.0])
+
+
+def test_leg_hours_credits_climb_to_leg(make_track):
+    track = equator(make_track, 0, 600, 600)
+    assert leg_hours(track) == pytest.approx([2.0, 1.0])
+
+
+def test_leg_hours_descent_adds_nothing(make_track):
+    track = equator(make_track, 600, 0)
+    assert leg_hours(track) == pytest.approx([1.0])
+
+
+def test_leg_hours_applies_fitness(make_track):
+    track = equator(make_track, 0, 600)
+    assert leg_hours(track, fitness=2.0) == pytest.approx([1.0])
+
+
+def test_leg_hours_ignores_jitter(make_track):
+    track = equator(make_track, 0, 1, 0, 1, 0)
+    assert leg_hours(track) == pytest.approx([1.0] * 4)
+
+
+def test_leg_hours_counts_slow_climb_where_threshold_reached(make_track):
+    # 1 m steps: the 3 m threshold is reached on the third leg, which gets the 3 m.
+    track = equator(make_track, 0, 1, 2, 3, 4, 5, 6)
+    hours = leg_hours(track)
+    expected_third = 1.0 + 3 / 600
+    assert hours[0] == pytest.approx(1.0)
+    assert hours[1] == pytest.approx(1.0)
+    assert hours[2] == pytest.approx(expected_third)
+    assert hours[5] == pytest.approx(expected_third)
+
+
+def test_leg_hours_sum_matches_summary_time(make_track):
+    track = equator(make_track, 0, 1, 2, 3, 10, 8, 2, 3, 4, 5, 300, 299)
+    ascent, _ = gain_and_loss([p.ele for p in track.points])
+    expected = naismith_hours(track.length_km(), ascent)
+    assert sum(leg_hours(track)) == pytest.approx(expected, abs=1e-3)
+    assert sum(leg_hours(track, fitness=1.5)) == pytest.approx(
+        naismith_hours(track.length_km(), ascent, 1.5), abs=1e-3
+    )
+
+
+def test_leg_hours_rejects_bad_fitness(make_track):
+    with pytest.raises(ValueError):
+        leg_hours(equator(make_track, 0, 0), fitness=0)
