+def test_steepest_grade_is_a_percentage(make_track):
+    # 100 m along the equator, in degrees of longitude.
+    lon_100m = degrees(0.1 / EARTH_RADIUS_KM)
+    track = make_track(
+        (0, 0, 500), (0, lon_100m, 518), (0, 2 * lon_100m, 518), (0, 3 * lon_100m, 513)
+    )
+    assert steepest_grade(track) == 18.0
+
+
+def test_steepest_grade_counts_descents_and_skips_repeated_points(make_track):
+    lon_100m = degrees(0.1 / EARTH_RADIUS_KM)
+    track = make_track((0, 0, 500), (0, 0, 900), (0, lon_100m, 487.5))
+    assert steepest_grade(track) == 412.5
+    assert steepest_grade(make_track((0, 0, 500), (0, 0, 900))) == 0.0
