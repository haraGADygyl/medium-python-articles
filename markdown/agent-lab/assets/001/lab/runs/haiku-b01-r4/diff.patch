+def test_long_climb_in_small_steps_is_counted():
+    # 100 points, 0.5 m apart: each step is under the 3 m threshold, but the
+    # climb as a whole is ~49.5 m and must not be lost. Counting happens in
+    # whole 3 m chunks, so the final 1.5 m short of the next chunk is not counted.
+    climb = [100 + 0.5 * i for i in range(100)]
+    assert gain_and_loss(climb) == (48.0, 0.0)
