+def test_long_climb_in_small_steps_is_counted():
+    # 300 one-metre steps: each step alone is below the threshold, but the
+    # climb accumulates against the last counted elevation.
+    climb = [100 + i for i in range(301)]
+    assert gain_and_loss(climb) == (300.0, 0.0)
+    assert gain_and_loss(climb[::-1]) == (0.0, 300.0)
