diff --git a/tests/test_track.py b/tests/test_track.py
new file mode 100644
index 0000000..b1b72cc
--- /dev/null
+++ b/tests/test_track.py
@@ -0,0 +1,309 @@
+import pytest
+
+from trailhead.track import Point, Track, TrackError, load_track, parse_track
+
+BODY = "lat,lon,ele\n0,0,100\n0,0.01,110\n"
+
+
+# --- the happy path -------------------------------------------------------------------
+
+
+def test_parses_the_readme_example():
+    text = (
+        "# name: Seven Rila Lakes\n"
+        "# units: m\n"
+        "lat,lon,ele\n"
+        "42.2031,23.3205,2140\n"
+        "42.2049,23.3188,2196\n"
+    )
+    track = parse_track(text)
+    assert track.name == "Seven Rila Lakes"
+    assert track.points == [Point(42.2031, 23.3205, 2140.0), Point(42.2049, 23.3188, 2196.0)]
+
+
+def test_track_error_is_a_value_error():
+    assert issubclass(TrackError, ValueError)
+    with pytest.raises(ValueError):
+        parse_track("lat,lon,ele\n0,0,0\n")
+
+
+def test_points_keep_their_order_and_values_are_floats():
+    track = parse_track("lat,lon,ele\n1,2,3\n-4.5,5.25,-6\n7,8,9\n")
+    assert [(p.lat, p.lon, p.ele) for p in track.points] == [
+        (1.0, 2.0, 3.0),
+        (-4.5, 5.25, -6.0),
+        (7.0, 8.0, 9.0),
+    ]
+    assert all(isinstance(v, float) for p in track.points for v in (p.lat, p.lon, p.ele))
+
+
+def test_blank_lines_and_comments_are_ignored_anywhere():
+    text = "\n# a comment\n\nlat,lon,ele\n\n0,0,100\n# another comment\n   \n0,0.01,110\n\n"
+    track = parse_track(text)
+    assert track.points == [Point(0, 0, 100), Point(0, 0.01, 110)]
+
+
+def test_surrounding_whitespace_is_tolerated():
+    track = parse_track("  lat,lon,ele  \n 0 , 0 , 100 \n\t0,0.01,110\t\n")
+    assert track.points == [Point(0, 0, 100), Point(0, 0.01, 110)]
+
+
+def test_windows_line_endings():
+    track = parse_track("# name: Crlf\r\nlat,lon,ele\r\n0,0,100\r\n0,0.01,110\r\n")
+    assert track.name == "Crlf"
+    assert len(track.points) == 2
+
+
+# --- names ----------------------------------------------------------------------------
+
+
+def test_name_defaults_to_unnamed():
+    assert parse_track(BODY).name == "unnamed"
+
+
+def test_name_defaults_to_default_name_argument():
+    assert parse_track(BODY, default_name="ridge").name == "ridge"
+
+
+def test_name_line_beats_default_name():
+    assert parse_track("# name: Musala\n" + BODY, default_name="ridge").name == "Musala"
+
+
+def test_name_line_after_the_points_still_counts():
+    assert parse_track(BODY + "# name: Late\n").name == "Late"
+
+
+def test_name_value_may_contain_colons_and_is_stripped():
+    assert parse_track("#   name:   Vihren: north face  \n" + BODY).name == "Vihren: north face"
+
+
+def test_comment_that_merely_mentions_name_is_not_a_setting():
+    assert parse_track("# the name of this walk is secret\n" + BODY).name == "unnamed"
+
+
+def test_empty_name_line_keeps_the_default():
+    assert parse_track("# name:\n" + BODY, default_name="ridge").name == "ridge"
+
+
+def test_load_track_names_track_after_the_file(write_track):
+    path = write_track(BODY, filename="rila.csv")
+    assert load_track(path).name == "rila"
+
+
+def test_load_track_accepts_a_string_path(write_track):
+    path = write_track(BODY, filename="rila.csv")
+    assert load_track(str(path)).name == "rila"
+
+
+def test_load_track_prefers_the_name_line(write_track):
+    path = write_track("# name: Seven Rila Lakes\n" + BODY, filename="rila.csv")
+    assert load_track(path).name == "Seven Rila Lakes"
+
+
+def test_load_track_reads_utf8(write_track):
+    path = write_track("# name: Мусала\n" + BODY)
+    assert load_track(path).name == "Мусала"
+
+
+def test_load_track_reports_problems_as_track_error(write_track):
+    path = write_track("lat,lon,ele\n0,0,0\n")
+    with pytest.raises(TrackError):
+        load_track(path)
+
+
+# --- units ----------------------------------------------------------------------------
+
+
+def test_elevations_default_to_metres():
+    assert [p.ele for p in parse_track(BODY).points] == [100.0, 110.0]
+
+
+def test_explicit_metres():
+    assert [p.ele for p in parse_track("# units: m\n" + BODY).points] == [100.0, 110.0]
+
+
+def test_feet_are_converted_to_metres():
+    track = parse_track("# units: ft\nlat,lon,ele\n0,0,1000\n0,0.01,-10\n")
+    assert track.points[0].ele == pytest.approx(304.8)
+    assert track.points[1].ele == pytest.approx(-3.048)
+
+
+def test_feet_do_not_change_coordinates():
+    track = parse_track("# units: ft\nlat,lon,ele\n42.5,23.25,0\n42.6,23.35,0\n")
+    assert (track.points[0].lat, track.points[0].lon) == (42.5, 23.25)
+    assert (track.points[1].lat, track.points[1].lon) == (42.6, 23.35)
+
+
+@pytest.mark.parametrize("units", ["km", "feet", "metres", ""])
+def test_other_units_are_an_error_with_line_number(units):
+    with pytest.raises(TrackError, match=r"^line 2:"):
+        parse_track(f"# name: x\n# units: {units}\n" + BODY)
+
+
+# --- header ---------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "header",
+    ["lon,lat,ele", "lat,lon", "lat,lon,ele,time", "latitude,longitude,elevation", "0,0,100"],
+)
+def test_first_non_comment_line_must_be_the_header(header):
+    text = f"# name: x\n\n{header}\n0,0,100\n0,0.01,110\n"
+    with pytest.raises(TrackError, match=r"^line 3:"):
+        parse_track(text)
+
+
+def test_missing_header_with_only_points_is_an_error():
+    with pytest.raises(TrackError, match=r"^line 1:"):
+        parse_track("0,0,100\n0,0.01,110\n0,0.02,120\n")
+
+
+def test_header_may_appear_only_once():
+    with pytest.raises(TrackError, match=r"^line 3:"):
+        parse_track("lat,lon,ele\n0,0,100\nlat,lon,ele\n0,0.01,110\n")
+
+
+# --- points ---------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize("row", ["0,0", "0,0,100,5", "0", "0,,100,"])
+def test_point_needs_three_fields(row):
+    with pytest.raises(TrackError, match=r"^line 3:"):
+        parse_track(f"lat,lon,ele\n0,0,100\n{row}\n0,0.02,120\n")
+
+
+@pytest.mark.parametrize("row", ["a,0,100", "0,b,100", "0,0,high", "0,,100", "0,0,"])
+def test_point_fields_must_be_numbers(row):
+    with pytest.raises(TrackError, match=r"^line 3:"):
+        parse_track(f"lat,lon,ele\n0,0,100\n{row}\n0,0.02,120\n")
+
+
+@pytest.mark.parametrize(
+    ("lat", "lon"),
+    [(90, 0), (-90, 0), (0, 180), (0, -180), (90, 180), (-90, -180)],
+)
+def test_coordinate_limits_are_inclusive(lat, lon):
+    track = parse_track(f"lat,lon,ele\n{lat},{lon},0\n0,0,0\n")
+    assert (track.points[0].lat, track.points[0].lon) == (lat, lon)
+
+
+@pytest.mark.parametrize(
+    ("lat", "lon"),
+    [(90.0001, 0), (-90.0001, 0), (0, 180.0001), (0, -180.0001), (91, 0), (0, 360)],
+)
+def test_coordinates_out_of_range_are_an_error(lat, lon):
+    with pytest.raises(TrackError, match=r"^line 3:"):
+        parse_track(f"lat,lon,ele\n0,0,0\n{lat},{lon},0\n")
+
+
+def test_elevation_has_no_range_limit():
+    track = parse_track("lat,lon,ele\n0,0,-430\n0,0.01,8849\n")
+    assert [p.ele for p in track.points] == [-430.0, 8849.0]
+
+
+# --- number of points -----------------------------------------------------------------
+
+
+def test_two_points_is_enough():
+    assert len(parse_track(BODY).points) == 2
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "",
+        "# name: empty\n",
+        "lat,lon,ele\n",
+        "lat,lon,ele\n0,0,100\n",
+        "# name: x\nlat,lon,ele\n\n0,0,100\n\n# only one\n",
+    ],
+)
+def test_fewer_than_two_points_is_an_error(text):
+    with pytest.raises(TrackError):
+        parse_track(text)
+
+
+def test_too_few_points_message_has_no_line_number():
+    with pytest.raises(TrackError) as error:
+        parse_track("lat,lon,ele\n0,0,100\n")
+    assert not str(error.value).startswith("line")
+
+
+# --- line numbers ---------------------------------------------------------------------
+
+
+def test_line_numbers_count_comments_and_blank_lines():
+    text = (
+        "# name: Counting\n"  # 1
+        "\n"  # 2
+        "# units: m\n"  # 3
+        "lat,lon,ele\n"  # 4
+        "\n"  # 5
+        "0,0,100\n"  # 6
+        "# halfway\n"  # 7
+        "0,0.01,110\n"  # 8
+        "\n"  # 9
+        "0,0.02,oops\n"  # 10
+    )
+    with pytest.raises(TrackError, match=r"^line 10:"):
+        parse_track(text)
+
+
+def test_line_number_of_the_first_bad_line_is_reported():
+    text = "lat,lon,ele\n0,0,100\n0,999,100\n0,0,x\n"
+    with pytest.raises(TrackError, match=r"^line 3:"):
+        parse_track(text)
+
+
+def test_load_track_line_numbers_match_the_file(write_track):
+    path = write_track("# name: x\n\nlat,lon,ele\n0,0,100\n0,0,\n")
+    with pytest.raises(TrackError, match=r"^line 5:"):
+        load_track(path)
+
+
+# --- Track ----------------------------------------------------------------------------
+
+
+def test_leg_lengths_are_great_circle_distances(make_track):
+    # 0.01 degrees of longitude along the equator on a sphere of radius 6371.0088 km.
+    track = make_track((0, 0, 0), (0, 0.01, 0), (0, 0.03, 0))
+    legs = track.leg_lengths_km()
+    assert legs == pytest.approx([1.11195, 2.22390], abs=1e-4)
+
+
+def test_length_is_the_sum_of_the_legs(make_track):
+    track = make_track((42.2031, 23.3205, 2140), (42.2049, 23.3188, 2196), (42.21, 23.31, 2300))
+    assert track.length_km() == pytest.approx(sum(track.leg_lengths_km()))
+
+
+def test_one_leg_fewer_than_points(make_track):
+    track = make_track((0, 0, 0), (0, 0.01, 0), (0.01, 0.01, 0), (0.01, 0, 0))
+    assert len(track.leg_lengths_km()) == 3
+
+
+def test_elevation_does_not_affect_length(make_track):
+    flat = make_track((0, 0, 0), (0, 0.01, 0))
+    steep = make_track((0, 0, 0), (0, 0.01, 1000))
+    assert flat.length_km() == steep.length_km()
+
+
+def test_repeated_points_make_a_zero_length_leg(make_track):
+    track = make_track((42, 23, 100), (42, 23, 100), (42, 23.01, 100))
+    assert track.leg_lengths_km()[0] == 0
+
+
+def test_track_without_points_has_zero_length():
+    assert Track("empty").leg_lengths_km() == []
+    assert Track("empty").length_km() == 0
+
+
+def test_points_are_immutable():
+    point = Point(0, 0, 0)
+    with pytest.raises(AttributeError):
+        point.ele = 1  # type: ignore[misc]
+
+
+def test_parsed_length_matches_a_known_distance():
+    sofia, plovdiv = (42.6977, 23.3219), (42.1354, 24.7453)
+    track = parse_track(f"lat,lon,ele\n{sofia[0]},{sofia[1]},550\n{plovdiv[0]},{plovdiv[1]},160\n")
+    assert track.length_km() == pytest.approx(132.5, abs=0.1)
