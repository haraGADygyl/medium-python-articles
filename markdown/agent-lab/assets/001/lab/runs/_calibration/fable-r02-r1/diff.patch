index 0000000..de8f1c4
--- /dev/null
+++ b/src/trailhead/timefmt.py
@@ -0,0 +1,7 @@
+"""Formatting times for display."""
+
+
+def format_duration(hours: float) -> str:
+    """A number of hours as text, rounded to the minute, for example ``5h 07m``."""
+    whole, minutes = divmod(round(hours * 60), 60)
+    return f"{whole}h {minutes:02d}m"
