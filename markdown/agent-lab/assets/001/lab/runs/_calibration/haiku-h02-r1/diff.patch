+def test_zero_threshold_counts_every_change(make_track):
+    # The default 3 m threshold ignores the 2 m and 1 m wobbles; threshold 0 counts them.
+    track = make_track((0, 0, 1000), (0, 0.01, 1002), (0, 0.02, 1001), (0, 0.03, 1003))
+    assert summarise(track).gain_m == 3.0
+    assert summarise(track, threshold=0).gain_m == 4.0
+    assert summarise(track, threshold=0).loss_m == 1.0
+
