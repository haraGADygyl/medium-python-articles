+def test_a_day_ends_before_the_leg_that_would_go_over_the_limit(five_flat_hours):
+    days = split_days(five_flat_hours, max_hours_per_day=2.5)
+    assert [(day, first, last) for day, first, last, _ in days] == [
+        (1, 0, 2),
+        (2, 2, 4),
+        (3, 4, 5),
+    ]
+    assert all(hours <= 2.5 for _, _, _, hours in days)
+
+
