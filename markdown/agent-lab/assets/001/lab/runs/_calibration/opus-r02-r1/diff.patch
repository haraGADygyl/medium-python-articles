diff --git a/src/trailhead/timefmt.py b/src/trailhead/timefmt.py
new file mode 100644
index 0000000..b92fcff
--- /dev/null
+++ b/src/trailhead/timefmt.py
@@ -0,0 +1,10 @@
+"""Formatting walking times for display."""
+
+
+def format_duration(hours: float) -> str:
+    """Format a number of hours as whole hours and minutes, for example ``5h 07m``.
+
+    The time is rounded to the nearest minute.
+    """
+    whole, minutes = divmod(round(hours * 60), 60)
+    return f"{whole}h {minutes:02d}m"
diff --git a/tests/test_timefmt.py b/tests/test_timefmt.py
new file mode 100644
index 0000000..757fad7
--- /dev/null
+++ b/tests/test_timefmt.py
@@ -0,0 +1,17 @@
+import pytest
+
+from trailhead.timefmt import format_duration
+
+
+@pytest.mark.parametrize(
+    ("hours", "expected"),
+    [
+        (0.0, "0h 00m"),
+        (5 + 7 / 60, "5h 07m"),
+        (6 + 5 / 60, "6h 05m"),
+        (1.999, "2h 00m"),  # rounds to the nearest minute, carrying into the hour
+        (12.5, "12h 30m"),
+    ],
+)
+def test_format_duration(hours, expected):
+    assert format_duration(hours) == expected
