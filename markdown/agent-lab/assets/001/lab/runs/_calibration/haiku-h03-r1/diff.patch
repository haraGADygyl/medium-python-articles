+def test_steepest_grade_is_percent(make_track):
+    # Roughly 100 m due north, climbing 18 m: a 18% grade.
+    track = make_track((42.0, 23.0, 1000), (42.0009, 23.0, 1018))
+    assert track.leg_lengths_km()[0] * 1000 == pytest.approx(100, rel=0.01)
+    assert steepest_grade(track) == 18.0
+
