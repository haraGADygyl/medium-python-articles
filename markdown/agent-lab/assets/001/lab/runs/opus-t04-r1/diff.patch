+import pytest
+
+from trailhead.pace import leg_hours, naismith_hours
+from trailhead.plan import DEFAULT_MAX_HOURS, describe_plan, split_days
+from trailhead.report import summarise
+
+# On the equator 0.1 degrees of longitude is about 11.12 km, 2.22 h of flat walking.
+STEP = 0.1
+
+
+def flat_track(make_track, legs, step=STEP, ele=500.0):
+    return make_track(*[(0.0, i * step, ele) for i in range(legs + 1)])
+
+
+def check_invariants(track, days, max_hours, fitness=1.0):
+    """Properties every plan must have, whatever the track."""
+    legs = leg_hours(track, fitness)
+    assert [day for day, *_ in days] == list(range(1, len(days) + 1))
+    assert days[0][1] == 0
+    assert days[-1][2] == len(track.points) - 1
+    for (_, _, last, _), (_, first, _, _) in zip(days, days[1:], strict=False):
+        assert first == last  # each day starts where the previous one ended
+    for _, first, last, hours in days:
+        assert first < last
+        assert hours == round(hours, 2)
+        if last - first > 1:
+            # A day of several legs must stay within the limit.
+            assert sum(legs[first:last]) <= max_hours + 1e-9
+
+
+# --- split_days ---------------------------------------------------------------
+
+
+def test_default_limit_is_seven_hours():
+    assert DEFAULT_MAX_HOURS == 7.0
+
+
+def test_short_walk_is_a_single_day(make_track):
+    track = flat_track(make_track, 2)
+    total = sum(leg_hours(track))
+    assert split_days(track) == [(1, 0, 2, round(total, 2))]
+
+
+def test_two_point_track(make_track):
+    track = make_track((0, 0, 100), (0, 0.01, 100))
+    [(day, first, last, hours)] = split_days(track)
+    assert (day, first, last) == (1, 0, 1)
+    assert hours == pytest.approx(1.11195 / 5, abs=0.01)
+
+
+def test_long_walk_is_split_into_days_within_the_limit(make_track):
+    track = flat_track(make_track, 12)  # about 26.7 hours in total
+    days = split_days(track)
+    assert len(days) >= 4
+    check_invariants(track, days, DEFAULT_MAX_HOURS)
+    for *_, hours in days:
+        assert hours <= DEFAULT_MAX_HOURS
+
+
+def test_uses_the_default_limit_when_not_given(make_track):
+    track = flat_track(make_track, 12)
+    assert split_days(track) == split_days(track, DEFAULT_MAX_HOURS)
+
+
+@pytest.mark.parametrize("max_hours", [2.5, 4.0, 6.0, 9.0, 30.0])
+def test_custom_limit(make_track, max_hours):
+    track = flat_track(make_track, 12)
+    days = split_days(track, max_hours)
+    check_invariants(track, days, max_hours)
+    for *_, hours in days:
+        assert hours <= max_hours
+
+
+def test_a_day_may_be_exactly_the_limit(make_track):
+    track = flat_track(make_track, 6)
+    legs = leg_hours(track)
+    limit = sum(legs[:3])
+    days = split_days(track, limit)
+    # The first three legs add up to exactly the limit, so they make one day.
+    assert days[0][:3] == (1, 0, 3)
+
+
+def test_a_leg_longer_than_the_limit_is_a_day_by_itself(make_track):
+    # Short legs, then one leg of 1 degree (about 22 hours), then short legs.
+    lons = [0.0, 0.01, 0.02, 1.02, 1.03, 1.04]
+    track = make_track(*[(0.0, lon, 100.0) for lon in lons])
+    days = split_days(track)
+    check_invariants(track, days, DEFAULT_MAX_HOURS)
+    assert (2, 3) in [(first, last) for _, first, last, _ in days]
+    long_day = next(d for d in days if (d[1], d[2]) == (2, 3))
+    assert long_day[3] == pytest.approx(111.195 / 5, abs=0.01)
+
+
+def test_overlong_first_and_last_legs(make_track):
+    lons = [0.0, 1.0, 1.01, 2.01]
+    track = make_track(*[(0.0, lon, 100.0) for lon in lons])
+    days = split_days(track)
+    assert [(day, first, last) for day, first, last, _ in days] == [
+        (1, 0, 1),
+        (2, 1, 2),
+        (3, 2, 3),
+    ]
+
+
+def test_consecutive_overlong_legs_are_separate_days(make_track):
+    lons = [0.0, 1.0, 2.0, 3.0]
+    track = make_track(*[(0.0, lon, 100.0) for lon in lons])
+    days = split_days(track)
+    assert [(first, last) for _, first, last, _ in days] == [(0, 1), (1, 2), (2, 3)]
+
+
+def test_hours_are_rounded_to_hundredths(make_track):
+    track = flat_track(make_track, 7, step=0.0137)
+    for *_, hours in split_days(track, 1.0):
+        assert hours == round(hours, 2)
+
+
+def test_climb_counts_towards_the_day(make_track):
+    flat = make_track((0, 0, 1000), (0, 0.01, 1000))
+    steep = make_track((0, 0, 1000), (0, 0.01, 1600))
+    [(*_, flat_hours)] = split_days(flat)
+    [(*_, steep_hours)] = split_days(steep)
+    assert steep_hours - flat_hours == pytest.approx(1.0, abs=0.01)
+
+
+def test_descent_adds_nothing(make_track):
+    flat = make_track((0, 0, 1000), (0, 0.01, 1000))
+    down = make_track((0, 0, 1600), (0, 0.01, 1000))
+    assert split_days(flat)[0][3] == split_days(down)[0][3]
+
+
+def test_repeated_points_are_allowed(make_track):
+    track = make_track((0, 0, 100), (0, 0, 100), (0, 0.01, 100), (0, 0.01, 100))
+    days = split_days(track)
+    check_invariants(track, days, DEFAULT_MAX_HOURS)
+    assert days == [(1, 0, 3, round(1.11195 / 5, 2))]
+
+
+# --- fitness --------------------------------------------------------------------
+
+
+def test_fitness_divides_the_time(make_track):
+    track = make_track((0, 0, 1000), (0, 0.05, 1600))
+    [(*_, average)] = split_days(track, 100)
+    [(*_, fast)] = split_days(track, 100, fitness=2.0)
+    assert fast == pytest.approx(average / 2, abs=0.01)
+
+
+def test_fitness_can_change_how_many_days(make_track):
+    track = flat_track(make_track, 12)
+    slow = split_days(track, fitness=0.8)
+    fast = split_days(track, fitness=1.6)
+    assert len(fast) < len(slow)
+    for days in (slow, fast):
+        for *_, hours in days:
+            assert hours <= DEFAULT_MAX_HOURS
+
+
+@pytest.mark.parametrize("fitness", [0, -1.0])
+def test_non_positive_fitness_is_an_error(make_track, fitness):
+    with pytest.raises(ValueError):
+        split_days(flat_track(make_track, 2), fitness=fitness)
+
+
+@pytest.mark.parametrize("max_hours", [0, -3.0])
+def test_non_positive_limit_is_an_error(make_track, max_hours):
+    with pytest.raises(ValueError):
+        split_days(flat_track(make_track, 2), max_hours)
+
+
+# --- agreement with the summary -----------------------------------------------
+
+
+def hilly_track(make_track):
+    """A track with GPS jitter, a climb in 1 m steps and a descent."""
+    elevations = [1000.0, 1001.0, 999.5, 1000.5, 1000.0]  # jitter below 3 m
+    elevations += [1000.0 + i for i in range(1, 301)]  # 300 m in 1 m steps
+    elevations += [1300.0 - 25 * i for i in range(1, 9)]  # descent
+    elevations += [1100.0, 1102.0, 1104.0, 1101.0, 1150.0, 1149.0]
+    return make_track(*[(42.0, 23.0 + i * 0.002, ele) for i, ele in enumerate(elevations)])
+
+
+@pytest.mark.parametrize("fitness", [1.0, 0.75, 1.2])
+@pytest.mark.parametrize("max_hours", [DEFAULT_MAX_HOURS, 1.0, 0.3])
+def test_days_add_up_to_the_summary_time(make_track, fitness, max_hours):
+    track = hilly_track(make_track)
+    days = split_days(track, max_hours, fitness)
+    check_invariants(track, days, max_hours, fitness)
+    total = sum(hours for *_, hours in days)
+    expected = summarise(track, fitness).hours
+    assert total == pytest.approx(expected, abs=0.005 * len(days) + 1e-3)
+
+
+def test_jitter_adds_no_time(make_track):
+    smooth = make_track(*[(0.0, i * 0.01, 1000.0) for i in range(6)])
+    jittery = make_track(
+        *[(0.0, i * 0.01, ele) for i, ele in enumerate([1000, 1001, 999, 1002, 1000, 1001])]
+    )
+    assert split_days(smooth) == split_days(jittery)
+
+
+def test_climb_in_small_steps_counts_in_full(make_track):
+    track = make_track(*[(0.0, i * 0.001, 1000.0 + i) for i in range(301)])
+    [(*_, hours)] = split_days(track, 100)
+    expected = naismith_hours(track.length_km(), 300)
+    assert hours == pytest.approx(expected, abs=0.005)
+
+
+def test_climb_is_credited_where_the_threshold_is_reached(make_track):
+    # Legs climb 2 m, 2 m, 0 m: the 4 m climb is credited to the second leg,
+    # so it belongs to whichever day contains that leg.
+    track = make_track((0, 0, 1000), (0, 0.5, 1002), (0, 1.0, 1004), (0, 1.5, 1004))
+    days = split_days(track, 12)  # each leg is about 11.1 h on its own
+    legs = [naismith_hours(km, 0) for km in track.leg_lengths_km()]
+    assert [(first, last) for _, first, last, _ in days] == [(0, 1), (1, 2), (2, 3)]
+    assert days[0][3] == round(legs[0], 2)
+    assert days[1][3] == round(legs[1] + 4 / 600, 2)
+    assert days[2][3] == round(legs[2], 2)
+
+
+# --- describe_plan ------------------------------------------------------------
+
+
+def test_describe_plan_example():
+    assert describe_plan([(2, 14, 31, 6 + 5 / 60)]) == ["Day 2: points 14-31, 6h 05m"]
+
+
+def test_describe_plan_one_line_per_day():
+    days = [(1, 0, 14, 5.12), (2, 14, 31, 0.75), (3, 31, 40, 12.0)]
+    assert describe_plan(days) == [
+        "Day 1: points 0-14, 5h 07m",
+        "Day 2: points 14-31, 0h 45m",
+        "Day 3: points 31-40, 12h 00m",
+    ]
+
+
+@pytest.mark.parametrize(
+    ("hours", "text"),
+    [
+        (0.0, "0h 00m"),
+        (0.01, "0h 01m"),  # 0.6 minutes rounds up
+        (0.005, "0h 00m"),  # 0.3 minutes rounds down
+        (1.99, "1h 59m"),  # 119.4 minutes
+        (1.995, "2h 00m"),  # 119.7 minutes rounds up into the next hour
+        (10.5, "10h 30m"),
+    ],
+)
+def test_describe_plan_rounds_to_the_nearest_minute(hours, text):
+    assert describe_plan([(1, 0, 1, hours)]) == [f"Day 1: points 0-1, {text}"]
+
+
+def test_describe_plan_empty():
+    assert describe_plan([]) == []
+
+
+def test_describe_plan_of_a_real_split(make_track):
+    track = flat_track(make_track, 12)
+    days = split_days(track)
+    lines = describe_plan(days)
+    assert len(lines) == len(days)
+    for line, (day, first, last, _) in zip(lines, days, strict=True):
+        assert line.startswith(f"Day {day}: points {first}-{last}, ")
