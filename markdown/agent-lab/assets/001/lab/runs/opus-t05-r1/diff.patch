+import dataclasses
+
+import pytest
+
+from trailhead.plan import split_days
+from trailhead.report import Summary, format_summary, summarise
+from trailhead.track import parse_track
+
+# Kilometres per degree of longitude along the equator (sphere of radius 6371.0088 km).
+KM_PER_DEGREE = 111.19508
+
+
+def east(km: float) -> float:
+    """Longitude, in degrees, of a point `km` east of (0, 0) along the equator."""
+    return km / KM_PER_DEGREE
+
+
+def make_summary(**changes: object) -> Summary:
+    values: dict[str, object] = {
+        "name": "Seven Rila Lakes",
+        "length_km": 12.3,
+        "gain_m": 540.0,
+        "loss_m": 470.0,
+        "highest_m": 2535.0,
+        "lowest_m": 2095.0,
+        "steepest_pct": 18.0,
+        "hours": 2.5,
+        "heading": "NE",
+    }
+    values.update(changes)
+    return Summary(**values)  # type: ignore[arg-type]
+
+
+# --- summarise -------------------------------------------------------------------------
+
+
+def test_summary_carries_the_track_name(make_track):
+    track = make_track((0, 0, 0), (0, east(1), 0), name="Musala")
+    assert summarise(track).name == "Musala"
+
+
+def test_length_is_great_circle_distance_rounded_to_a_tenth(make_track):
+    # 1.112 km along the equator, in two legs.
+    track = make_track((0, 0, 0), (0, 0.005, 0), (0, 0.01, 0))
+    assert summarise(track).length_km == 1.1
+
+
+def test_length_of_a_meridian_leg(make_track):
+    # One degree of latitude is 111.19508 km on this sphere.
+    track = make_track((0, 0, 0), (1, 0, 0))
+    assert summarise(track).length_km == 111.2
+
+
+def test_gain_and_loss(make_track):
+    track = make_track((0, 0, 1000), (0, east(1), 1200), (0, east(2), 1050))
+    summary = summarise(track)
+    assert (summary.gain_m, summary.loss_m) == (200.0, 150.0)
+
+
+def test_jitter_below_the_threshold_adds_nothing(make_track):
+    elevations = [1000, 1001, 1000, 999, 1000, 1001, 1000]
+    track = make_track(*[(0, east(index * 0.1), ele) for index, ele in enumerate(elevations)])
+    summary = summarise(track)
+    assert (summary.gain_m, summary.loss_m) == (0.0, 0.0)
+
+
+def test_climb_in_small_steps_still_counts_in_full(make_track):
+    track = make_track(*[(0, east(index * 0.01), 1000 + index) for index in range(301)])
+    assert summarise(track).gain_m == 300.0
+
+
+def test_gain_and_loss_are_rounded_to_a_tenth(make_track):
+    track = make_track((0, 0, 1000), (0, east(1), 1010.04), (0, east(2), 1000.0))
+    summary = summarise(track)
+    assert (summary.gain_m, summary.loss_m) == (10.0, 10.0)
+
+
+def test_threshold_argument_is_used(make_track):
+    track = make_track((0, 0, 1000), (0, east(1), 1004), (0, east(2), 1000))
+    assert (summarise(track).gain_m, summarise(track).loss_m) == (4.0, 4.0)
+    summary = summarise(track, threshold=5)
+    assert (summary.gain_m, summary.loss_m) == (0.0, 0.0)
+    summary = summarise(track, threshold=0)
+    assert (summary.gain_m, summary.loss_m) == (4.0, 4.0)
+
+
+def test_negative_threshold_is_an_error(make_track):
+    track = make_track((0, 0, 0), (0, east(1), 0))
+    with pytest.raises(ValueError):
+        summarise(track, threshold=-1)
+
+
+def test_highest_and_lowest(make_track):
+    track = make_track((0, 0, 1500), (0, east(1), 2200), (0, east(2), 900), (0, east(3), 1200))
+    summary = summarise(track)
+    assert (summary.highest_m, summary.lowest_m) == (2200, 900)
+
+
+def test_steepest_grade_is_in_percent(make_track):
+    # 18 m up over 100 m is 18.0%; the gentler leg does not matter.
+    track = make_track((0, 0, 1000), (0, east(0.1), 1018), (0, east(1.1), 1028))
+    assert summarise(track).steepest_pct == 18.0
+
+
+def test_steepest_grade_counts_downhill(make_track):
+    track = make_track((0, 0, 1000), (0, east(1), 1010), (0, east(1.1), 975))
+    assert summarise(track).steepest_pct == 35.0
+
+
+def test_steepest_grade_skips_repeated_points(make_track):
+    track = make_track((0, 0, 1000), (0, 0, 1050), (0, east(1), 1100))
+    assert summarise(track).steepest_pct == 5.0
+
+
+def test_flat_walking_time_is_five_km_an_hour(make_track):
+    track = make_track((0, 0, 0), (0, east(10), 0))
+    assert summarise(track).hours == pytest.approx(2.0)
+
+
+def test_ascent_adds_an_hour_per_600_m(make_track):
+    track = make_track((0, 0, 1000), (0, east(5), 1600))
+    assert summarise(track).hours == pytest.approx(2.0)
+
+
+def test_descent_adds_no_time(make_track):
+    track = make_track((0, 0, 1600), (0, east(5), 1000))
+    assert summarise(track).hours == pytest.approx(1.0)
+
+
+def test_time_uses_the_unrounded_distance(make_track):
+    # 1.112 km is displayed as 1.1 km, but the time must not be rounded with it.
+    track = make_track((0, 0, 0), (0, 0.01, 0))
+    summary = summarise(track)
+    assert summary.length_km == 1.1
+    assert summary.hours == pytest.approx(0.01 * KM_PER_DEGREE / 5)
+
+
+def test_time_uses_the_counted_ascent(make_track):
+    # Jitter adds no ascent, so it adds no time either.
+    track = make_track((0, 0, 1000), (0, east(2.5), 1002), (0, east(5), 1000))
+    assert summarise(track).hours == pytest.approx(1.0)
+
+
+def test_time_follows_the_threshold(make_track):
+    track = make_track((0, 0, 1000), (0, east(5), 1006))
+    assert summarise(track).hours == pytest.approx(1.01)
+    assert summarise(track, threshold=10).hours == pytest.approx(1.0)
+
+
+def test_fitness_divides_the_time(make_track):
+    track = make_track((0, 0, 1000), (0, east(5), 1600))
+    assert summarise(track, fitness=1.25).hours == pytest.approx(2.0 / 1.25)
+    assert summarise(track, fitness=0.8).hours == pytest.approx(2.0 / 0.8)
+
+
+@pytest.mark.parametrize("fitness", [0, -1])
+def test_non_positive_fitness_is_an_error(make_track, fitness):
+    track = make_track((0, 0, 0), (0, east(1), 0))
+    with pytest.raises(ValueError):
+        summarise(track, fitness=fitness)
+
+
+@pytest.mark.parametrize(
+    ("lat", "lon", "heading"),
+    [
+        (0.1, 0, "N"),
+        (0.1, 0.1, "NE"),
+        (0, 0.1, "E"),
+        (-0.1, 0.1, "SE"),
+        (-0.1, 0, "S"),
+        (-0.1, -0.1, "SW"),
+        (0, -0.1, "W"),
+        (0.1, -0.1, "NW"),
+    ],
+)
+def test_heading_is_the_compass_point_from_start_to_finish(make_track, lat, lon, heading):
+    track = make_track((0, 0, 0), (lat, lon, 0))
+    assert summarise(track).heading == heading
+
+
+def test_heading_ignores_the_route_in_between(make_track):
+    # Walk far west first, then finish east of the start.
+    track = make_track((0, 0, 0), (0, -0.5, 0), (0, 0.1, 0))
+    assert summarise(track).heading == "E"
+
+
+def test_heading_is_loop_when_finish_is_within_100_m_of_start(make_track):
+    track = make_track((0, 0, 0), (0, east(3), 0), (0, east(0.09), 0))
+    assert summarise(track).heading == "loop"
+
+
+def test_heading_is_loop_when_finish_is_the_start(make_track):
+    track = make_track((0, 0, 0), (0.05, 0.05, 0), (0, 0, 0))
+    assert summarise(track).heading == "loop"
+
+
+def test_heading_is_not_loop_just_beyond_100_m(make_track):
+    track = make_track((0, 0, 0), (0, east(3), 0), (0, east(0.11), 0))
+    assert summarise(track).heading == "E"
+
+
+def test_summary_is_immutable(make_track):
+    summary = summarise(make_track((0, 0, 0), (0, east(1), 0)))
+    with pytest.raises(dataclasses.FrozenInstanceError):
+        summary.name = "other"  # type: ignore[misc]
+
+
+def test_summary_of_a_track_in_feet():
+    # 3280.84 ft is 1000 m; everything after parsing is in metres.
+    text = "# units: ft\nlat,lon,ele\n0,0,0\n0,0.0449660,3280.84\n"
+    summary = summarise(parse_track(text))
+    assert summary.name == "unnamed"
+    assert summary.gain_m == pytest.approx(1000.0, abs=0.1)
+    assert summary.highest_m == pytest.approx(1000.0, abs=0.01)
+
+
+@pytest.mark.parametrize("fitness", [1.0, 1.2, 0.7])
+def test_plan_days_add_up_to_the_summary_time(make_track, fitness):
+    elevations = [1000, 1001, 1150, 1148, 1300, 1290, 1100, 1105, 1400, 1000]
+    track = make_track(*[(0, east(index * 2.3), ele) for index, ele in enumerate(elevations)])
+    days = split_days(track, max_hours_per_day=2, fitness=fitness)
+    assert len(days) > 1
+    # Each day is rounded to 0.01 h.
+    total = sum(hours for *_, hours in days)
+    assert total == pytest.approx(summarise(track, fitness=fitness).hours, abs=0.005 * len(days))
+
+
+# --- format_summary --------------------------------------------------------------------
+
+
+def test_format_summary():
+    assert format_summary(make_summary()) == (
+        "Seven Rila Lakes\n"
+        "  distance  12.3 km\n"
+        "  ascent    +540 m / -470 m\n"
+        "  altitude  2095-2535 m\n"
+        "  steepest  18.0%\n"
+        "  time      2h 30m\n"
+        "  heading   NE"
+    )
+
+
+@pytest.mark.parametrize(
+    ("hours", "shown"),
+    [
+        (5 + 7 / 60, "5h 07m"),
+        (0.75, "0h 45m"),
+        (12.0, "12h 00m"),
+        (0.0, "0h 00m"),
+        (1 + 7.4 / 60, "1h 07m"),
+        (1 + 7.6 / 60, "1h 08m"),
+        (11 + 59.7 / 60, "12h 00m"),
+        (2 + 59.4 / 60, "2h 59m"),
+    ],
+)
+def test_durations_are_rounded_to_the_nearest_minute(hours, shown):
+    lines = format_summary(make_summary(hours=hours)).splitlines()
+    assert lines[5] == f"  time      {shown}"
+
+
+def test_format_shows_loop_heading():
+    lines = format_summary(make_summary(heading="loop")).splitlines()
+    assert lines[-1] == "  heading   loop"
+
+
+def test_format_rounds_metres_and_keeps_a_decimal_for_km_and_percent():
+    summary = make_summary(
+        length_km=4.0, gain_m=12.4, loss_m=0.0, highest_m=812.6, lowest_m=799.6, steepest_pct=7.0
+    )
+    lines = format_summary(summary).splitlines()
+    assert lines[1:5] == [
+        "  distance  4.0 km",
+        "  ascent    +12 m / -0 m",
+        "  altitude  800-813 m",
+        "  steepest  7.0%",
+    ]
+
+
+def test_format_of_a_real_summary(make_track):
+    track = make_track(
+        (0, 0, 1000), (0, east(0.1), 1018), (0, east(5), 1300), (0, east(10), 1200), name="Ridge"
+    )
+    assert format_summary(summarise(track)) == (
+        "Ridge\n"
+        "  distance  10.0 km\n"
+        "  ascent    +300 m / -100 m\n"
+        "  altitude  1000-1300 m\n"
+        "  steepest  18.0%\n"
+        "  time      2h 30m\n"
+        "  heading   E"
+    )
