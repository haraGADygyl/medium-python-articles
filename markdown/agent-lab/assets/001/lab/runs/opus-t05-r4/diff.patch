+import dataclasses
+
+import pytest
+
+from trailhead.pace import naismith_hours
+from trailhead.plan import split_days
+from trailhead.report import Summary, format_summary, summarise
+from trailhead.track import parse_track
+
+# Kilometres per degree of longitude on the equator (sphere of radius 6371.0088 km).
+KM_PER_DEGREE = 111.19508
+
+
+def deg(km: float) -> float:
+    """Degrees of longitude along the equator covering ``km`` kilometres."""
+    return km / KM_PER_DEGREE
+
+
+def make_summary(**overrides: object) -> Summary:
+    fields: dict[str, object] = {
+        "name": "Seven Rila Lakes",
+        "length_km": 12.3,
+        "gain_m": 456.0,
+        "loss_m": 321.0,
+        "highest_m": 2535.0,
+        "lowest_m": 2095.0,
+        "steepest_pct": 18.0,
+        "hours": 5 + 7 / 60,
+        "heading": "NE",
+    }
+    fields.update(overrides)
+    return Summary(**fields)  # type: ignore[arg-type]
+
+
+# --- summarise -------------------------------------------------------------
+
+
+def test_name_comes_from_the_track(make_track):
+    track = make_track((0, 0, 0), (0, deg(1), 0), name="Seven Rila Lakes")
+    assert summarise(track).name == "Seven Rila Lakes"
+
+
+def test_length_is_great_circle_distance_rounded_to_a_tenth(make_track):
+    track = make_track((0, 0, 0), (0, 1, 0))
+    assert summarise(track).length_km == 111.2
+
+
+def test_length_adds_up_all_legs(make_track):
+    track = make_track((0, 0, 0), (0, deg(2), 0), (0, deg(5), 0), (0, deg(3), 0))
+    assert summarise(track).length_km == pytest.approx(7.0)
+
+
+def test_gain_and_loss(make_track):
+    track = make_track((0, 0, 100), (0, deg(1), 400), (0, deg(2), 250))
+    summary = summarise(track)
+    assert (summary.gain_m, summary.loss_m) == (300.0, 150.0)
+
+
+def test_jitter_below_the_default_threshold_is_ignored(make_track):
+    elevations = [1000, 1001, 999, 1001, 1000, 999, 1000]
+    track = make_track(*[(0, deg(i), ele) for i, ele in enumerate(elevations)])
+    summary = summarise(track)
+    assert (summary.gain_m, summary.loss_m) == (0.0, 0.0)
+
+
+def test_a_climb_in_small_steps_still_counts(make_track):
+    track = make_track(*[(0, deg(i / 10), 1000 + i) for i in range(301)])
+    assert summarise(track).gain_m == 300.0
+
+
+def test_threshold_is_passed_on(make_track):
+    track = make_track((0, 0, 100), (0, deg(1), 104), (0, deg(2), 100))
+    assert (summarise(track).gain_m, summarise(track).loss_m) == (4.0, 4.0)
+    summary = summarise(track, threshold=5)
+    assert (summary.gain_m, summary.loss_m) == (0.0, 0.0)
+
+
+def test_negative_threshold_is_an_error(make_track):
+    track = make_track((0, 0, 0), (0, deg(1), 0))
+    with pytest.raises(ValueError):
+        summarise(track, threshold=-1)
+
+
+def test_highest_and_lowest(make_track):
+    track = make_track((0, 0, 1200), (0, deg(1), 2500), (0, deg(2), 900), (0, deg(3), 1500))
+    summary = summarise(track)
+    assert (summary.highest_m, summary.lowest_m) == (2500, 900)
+
+
+def test_steepest_grade_in_percent(make_track):
+    # A leg climbing 18 m over 100 m is 18.0.
+    track = make_track((0, 0, 0), (0, deg(1), 50), (0, deg(1.1), 68))
+    assert summarise(track).steepest_pct == 18.0
+
+
+def test_steepest_grade_counts_downhill(make_track):
+    track = make_track((0, 0, 100), (0, deg(0.1), 75), (0, deg(1.1), 75))
+    assert summarise(track).steepest_pct == 25.0
+
+
+def test_steepest_grade_skips_repeated_points(make_track):
+    track = make_track((0, 0, 0), (0, 0, 50), (0, deg(0.1), 60))
+    assert summarise(track).steepest_pct == 10.0
+
+
+def test_hours_follow_naismith(make_track):
+    # 10 km and 600 m of ascent: 2 h on the flat plus 1 h of climbing.
+    track = make_track((0, 0, 0), (0, deg(10), 600))
+    assert summarise(track).hours == pytest.approx(3.0)
+
+
+def test_descent_adds_no_time(make_track):
+    track = make_track((0, 0, 600), (0, deg(10), 0))
+    assert summarise(track).hours == pytest.approx(2.0)
+
+
+def test_fitness_divides_the_time(make_track):
+    track = make_track((0, 0, 0), (0, deg(10), 600))
+    assert summarise(track, fitness=1.25).hours == pytest.approx(3.0 / 1.25)
+    assert summarise(track, fitness=0.5).hours == pytest.approx(6.0)
+
+
+@pytest.mark.parametrize("fitness", [0, -1])
+def test_non_positive_fitness_is_an_error(make_track, fitness):
+    track = make_track((0, 0, 0), (0, deg(1), 0))
+    with pytest.raises(ValueError):
+        summarise(track, fitness=fitness)
+
+
+def test_hours_are_not_rounded(make_track):
+    # Times are not rounded until displayed, so the time uses the exact length,
+    # not the length rounded to 0.1 km for display.
+    track = make_track((0, 0, 0), (0, deg(1.04), 0))
+    summary = summarise(track)
+    assert summary.length_km == 1.0
+    assert summary.hours == pytest.approx(naismith_hours(track.length_km(), 0))
+    assert summary.hours == pytest.approx(1.04 / 5, rel=1e-6)
+
+
+def test_summary_time_matches_the_day_plan(make_track):
+    # The days of a plan add up to the summary time for the same track and fitness.
+    elevations = [1000, 1001, 1004, 1050, 1049, 1200, 1150, 1152, 1300, 1000]
+    track = make_track(*[(0, deg(1.7 * i), ele) for i, ele in enumerate(elevations)])
+    for fitness in (1.0, 1.3):
+        days = split_days(track, max_hours_per_day=1.5, fitness=fitness)
+        planned = sum(hours for *_, hours in days)
+        # Each day's hours are rounded to 0.01, hence the tolerance.
+        expected = pytest.approx(planned, abs=0.01 * len(days))
+        assert summarise(track, fitness=fitness).hours == expected
+
+
+@pytest.mark.parametrize(
+    ("finish", "heading"),
+    [
+        ((1, 0), "N"),
+        ((1, 1), "NE"),
+        ((0, 1), "E"),
+        ((-1, 1), "SE"),
+        ((-1, 0), "S"),
+        ((-1, -1), "SW"),
+        ((0, -1), "W"),
+        ((1, -1), "NW"),
+    ],
+)
+def test_heading_is_the_compass_point_from_start_to_finish(make_track, finish, heading):
+    lat, lon = finish
+    track = make_track((0, 0, 0), (0.5, 0.5, 0), (lat, lon, 0))
+    assert summarise(track).heading == heading
+
+
+def test_heading_ignores_the_route_in_between(make_track):
+    track = make_track((0, 0, 0), (0, -1, 0), (-1, -1, 0), (0, 1, 0))
+    assert summarise(track).heading == "E"
+
+
+def test_loop_when_finish_is_within_a_tenth_of_a_km(make_track):
+    track = make_track((0, 0, 0), (0, deg(3), 0), (0, deg(0.09), 0))
+    assert summarise(track).heading == "loop"
+
+
+def test_finish_back_at_the_start_is_a_loop(make_track):
+    track = make_track((0, 0, 0), (0, deg(3), 0), (0, 0, 0))
+    assert summarise(track).heading == "loop"
+
+
+def test_not_a_loop_just_beyond_a_tenth_of_a_km(make_track):
+    track = make_track((0, 0, 0), (0, deg(3), 0), (0, deg(0.11), 0))
+    assert summarise(track).heading == "E"
+
+
+def test_summarise_a_parsed_track_in_feet():
+    text = (
+        "lat,lon,ele\n"
+        "0,0,1000\n"
+        f"0,{deg(10)},2968.5\n"
+        "# name: Feet Walk\n"
+        "# units: ft\n"
+    )
+    summary = summarise(parse_track(text))
+    assert summary.name == "Feet Walk"
+    assert summary.length_km == 10.0
+    assert summary.lowest_m == pytest.approx(304.8)
+    assert summary.highest_m == pytest.approx(2968.5 * 0.3048)
+    assert summary.gain_m == pytest.approx(round(1968.5 * 0.3048, 1))
+    assert summary.hours == pytest.approx(2 + summary.gain_m / 600)
+
+
+def test_summary_is_immutable(make_track):
+    summary = summarise(make_track((0, 0, 0), (0, deg(1), 0)))
+    with pytest.raises(dataclasses.FrozenInstanceError):
+        summary.hours = 0  # type: ignore[misc]
+
+
+# --- format_summary --------------------------------------------------------
+
+
+def test_format_summary():
+    assert format_summary(make_summary()) == "\n".join(
+        [
+            "Seven Rila Lakes",
+            "  distance  12.3 km",
+            "  ascent    +456 m / -321 m",
+            "  altitude  2095-2535 m",
+            "  steepest  18.0%",
+            "  time      5h 07m",
+            "  heading   NE",
+        ]
+    )
+
+
+def time_line(hours: float) -> str:
+    return format_summary(make_summary(hours=hours)).splitlines()[5]
+
+
+@pytest.mark.parametrize(
+    ("hours", "shown"),
+    [
+        (5 + 7 / 60, "5h 07m"),
+        (0.75, "0h 45m"),
+        (12.0, "12h 00m"),
+        (0.0, "0h 00m"),
+    ],
+)
+def test_durations_from_the_readme(hours, shown):
+    assert time_line(hours) == f"  time      {shown}"
+
+
+@pytest.mark.parametrize(
+    ("hours", "shown"),
+    [
+        (1 + 7.4 / 60, "1h 07m"),
+        (1 + 7.6 / 60, "1h 08m"),
+        (1 + 59.7 / 60, "2h 00m"),
+        (2 + 0.3 / 60, "2h 00m"),
+    ],
+)
+def test_durations_round_to_the_nearest_minute(hours, shown):
+    assert time_line(hours) == f"  time      {shown}"
+
+
+def test_format_shows_loop_heading():
+    assert format_summary(make_summary(heading="loop")).endswith("  heading   loop")
+
+
+def test_format_round_trip_from_summarise(make_track):
+    track = make_track((0, 0, 0), (0, deg(10), 600), name="Ridge")
+    lines = format_summary(summarise(track)).splitlines()
+    assert lines[0] == "Ridge"
+    assert lines[1] == "  distance  10.0 km"
+    assert lines[2] == "  ascent    +600 m / -0 m"
+    assert lines[3] == "  altitude  0-600 m"
+    assert lines[4] == "  steepest  6.0%"
+    assert lines[5] == "  time      3h 00m"
+    assert lines[6] == "  heading   E"
