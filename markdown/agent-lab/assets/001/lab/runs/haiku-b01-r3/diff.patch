+def test_long_climb_in_small_steps_is_counted():
+    # 100 points, 1 m apart: each step is below the 3 m threshold, but the climb
+    # is 99 m in total and must be counted once the threshold is reached.
+    elevations = [100 + i for i in range(100)]
+    gain, loss = gain_and_loss(elevations)
