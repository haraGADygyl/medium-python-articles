diff --git a/src/trailhead/track.py b/src/trailhead/track.py
index 48670aa..f1aaea7 100644
--- a/src/trailhead/track.py
+++ b/src/trailhead/track.py
@@ -33,6 +33,23 @@ class Track:
     def length_km(self) -> float:
         return sum(self.leg_lengths_km())
 
+    def elevations(self) -> list[float]:
+        """Elevation of every point in metres, with gaps filled as the README describes.
+
+        A point without an elevation takes the nearest earlier elevation or, if there
+        is none, the nearest later one.
+        """
+        first_known = next((p.ele for p in self.points if p.ele is not None), None)
+        if first_known is None:
+            raise TrackError("no point has an elevation")
+        filled: list[float] = []
+        last = first_known
+        for point in self.points:
+            if point.ele is not None:
+                last = point.ele
+            filled.append(last)
+        return filled
+
 
 def parse_track(text: str, default_name: str | None = None) -> Track:
     """Parse a track; see the README for the format."""
diff --git a/tests/test_track.py b/tests/test_track.py
index 978ce36..23c9f08 100644
--- a/tests/test_track.py
+++ b/tests/test_track.py
@@ -65,3 +65,13 @@ def test_track_length_is_the_sum_of_legs(make_track):
     track = make_track((0, 0, 0), (0, 0.01, 0), (0, 0.03, 0))
     assert track.leg_lengths_km() == pytest.approx([1.11195, 2.2239], abs=1e-3)
     assert track.length_km() == pytest.approx(3.33585, abs=1e-3)
+
+
+def test_missing_elevation_takes_the_nearest_earlier_one_else_the_later_one():
+    track = parse_track("lat,lon,ele\n0,0,\n0,0.01,100\n0,0.02,\n0,0.03,120\n0,0.04,\n")
+    assert track.elevations() == [100, 100, 100, 120, 120]
+
+
+def test_track_without_any_elevation_is_an_error():
+    with pytest.raises(TrackError):
+        parse_track("lat,lon,ele\n0,0,\n0,0.01,\n").elevations()
