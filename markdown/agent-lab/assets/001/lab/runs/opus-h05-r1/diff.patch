 """Walking-time estimates."""
 
-from itertools import pairwise
 from math import exp
 
+from trailhead.elevation import counted_changes
 from trailhead.track import Track
 
 FLAT_SPEED_KMH = 5.0
@@ -32,8 +32,14 @@ def tobler_kmh(grade: float) -> float:
 
 
 def leg_hours(track: Track, fitness: float = 1.0) -> list[float]:
-    """Naismith time for every leg, counting the leg's own climb."""
+    """Naismith time for every leg.
+
+    A leg's climb is the ascent the summary credits to it (``counted_changes`` with
+    the default threshold), so the legs add up to the summary's walking time and GPS
+    jitter is not counted as climbing.
+    """
+    changes = counted_changes([point.ele for point in track.points])
     return [
-        naismith_hours(km, max(b.ele - a.ele, 0.0), fitness)
-        for (a, b), km in zip(pairwise(track.points), track.leg_lengths_km(), strict=True)
+        naismith_hours(km, max(change, 0.0), fitness)
+        for change, km in zip(changes, track.leg_lengths_km(), strict=True)
     ]
diff --git a/tests/test_pace.py b/tests/test_pace.py
index 6aec825..6b30e43 100644
--- a/tests/test_pace.py
+++ b/tests/test_pace.py
@@ -28,3 +28,10 @@ def test_leg_hours(make_track):
     climb, descent = leg_hours(track)
     assert climb == pytest.approx(1.11195 / 5 + 0.5, abs=1e-4)
     assert descent == pytest.approx(1.11195 / 5, abs=1e-4)
+
+
+def test_leg_hours_ignore_jitter(make_track):
+    # 1 m up-and-down noise is below the 3 m threshold, so it is not climbing.
+    track = make_track(*[(0, i * 0.001, 1000 + i % 2) for i in range(11)])
+    hours = leg_hours(track)
+    assert sum(hours) == pytest.approx(track.length_km() / 5)
