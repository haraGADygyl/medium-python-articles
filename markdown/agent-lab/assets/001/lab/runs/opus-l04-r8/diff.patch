diff --git a/src/trailhead/track.py b/src/trailhead/track.py
index 48670aa..5f7ffcd 100644
--- a/src/trailhead/track.py
+++ b/src/trailhead/track.py
@@ -33,6 +33,24 @@ class Track:
     def length_km(self) -> float:
         return sum(self.leg_lengths_km())
 
+    def elevations(self) -> list[float]:
+        """Elevation of every point in metres, with gaps filled.
+
+        A point without an elevation takes that of the nearest earlier point that
+        has one or, if there is none, of the nearest later point. Raises
+        `TrackError` if no point has an elevation.
+        """
+        known = [point.ele for point in self.points if point.ele is not None]
+        if not known:
+            raise TrackError("no point has an elevation")
+        last = known[0]
+        filled: list[float] = []
+        for point in self.points:
+            if point.ele is not None:
+                last = point.ele
+            filled.append(last)
+        return filled
+
 
 def parse_track(text: str, default_name: str | None = None) -> Track:
     """Parse a track; see the README for the format."""
@@ -62,6 +80,8 @@ def parse_track(text: str, default_name: str | None = None) -> Track:
         points.append(_parse_point(line, number))
     if len(points) < 2:
         raise TrackError("a track needs at least two points")
+    if all(point.ele is None for point in points):
+        raise TrackError("no point has an elevation")
     if scale != 1.0:
         points = [
             Point(p.lat, p.lon, None if p.ele is None else p.ele * scale) for p in points
diff --git a/tests/test_track.py b/tests/test_track.py
index 978ce36..0cb4287 100644
--- a/tests/test_track.py
+++ b/tests/test_track.py
@@ -65,3 +65,13 @@ def test_track_length_is_the_sum_of_legs(make_track):
     track = make_track((0, 0, 0), (0, 0.01, 0), (0, 0.03, 0))
     assert track.leg_lengths_km() == pytest.approx([1.11195, 2.2239], abs=1e-3)
     assert track.length_km() == pytest.approx(3.33585, abs=1e-3)
+
+
+def test_missing_elevations_take_the_nearest_earlier_then_later_one():
+    track = parse_track("lat,lon,ele\n0,0,\n0,0.01,\n0,0.02,120\n0,0.03,\n0,0.04,90\n")
+    assert track.elevations() == [120, 120, 120, 120, 90]
+
+
+def test_a_track_without_any_elevation_is_rejected():
+    with pytest.raises(TrackError, match="no point has an elevation"):
+        parse_track("lat,lon,ele\n0,0,\n0,0.01,\n")
