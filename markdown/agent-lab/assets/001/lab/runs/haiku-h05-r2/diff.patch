     assert descent == pytest.approx(1.11195 / 5, abs=1e-4)
+
+
+def test_leg_hours_ignore_jitter_below_the_threshold(make_track):
+    # Up and down by 1 m on every leg: no climb counts at the default 3 m threshold.
+    track = make_track(*[(0, index * 0.01, 1000 + index % 2) for index in range(10)])
+    flat = [naismith_hours(km, 0) for km in track.leg_lengths_km()]
+    assert leg_hours(track) == pytest.approx(flat)
+    assert sum(leg_hours(track, threshold=0)) > sum(flat)
