     for elevation in elevations[1:]:
+        if elevation is None:
+            changes.append(0.0)
+            continue
+        if reference is None:
+            reference = elevation
+            changes.append(0.0)
+            continue
         change = elevation - reference
         if change > 0 and change >= threshold:
             changes.append(change)
