diff --git a/src/trailhead/track.py b/src/trailhead/track.py
index 48670aa..09b7623 100644
--- a/src/trailhead/track.py
+++ b/src/trailhead/track.py
@@ -30,6 +30,23 @@ class Track:
         """Length of each leg, the stretch between two consecutive points."""
         return [haversine_km(a.lat, a.lon, b.lat, b.lon) for a, b in pairwise(self.points)]
 
+    def filled_elevations(self) -> list[float]:
+        """Elevation of every point in metres, one per point.
+
+        A point without an elevation takes that of the nearest earlier point that
+        has one or, if there is none, of the nearest later point.
+        """
+        known = [p.ele for p in self.points if p.ele is not None]
+        if not known:
+            raise TrackError("a track needs an elevation on at least one point")
+        filled: list[float] = []
+        last = known[0]
+        for point in self.points:
+            if point.ele is not None:
+                last = point.ele
+            filled.append(last)
+        return filled
+
     def length_km(self) -> float:
         return sum(self.leg_lengths_km())
 
