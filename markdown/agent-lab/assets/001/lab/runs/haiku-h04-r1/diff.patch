+def test_flat_walk_time_is_rounded_not_truncated(make_track):
+    # 3.74 km on the flat is 44.88 minutes by Naismith's rule: shown as 45m.
+    # One degree of longitude on the equator is about 111.195 km.
+    track = make_track((0, 0, 100), (0, 3.74 / 111.19508, 100), name="Flat")
+    summary = summarise(track)
+    assert summary.length_km == 3.7
+    assert summary.hours * 60 == pytest.approx(44.88, abs=0.02)
+    assert "  time      0h 45m" in format_summary(summary).splitlines()
