     return (distance_km / FLAT_SPEED_KMH + ascent_m / CLIMB_M_PER_HOUR) / fitness
 
 
+def format_duration(hours: float) -> str:
+    """Display a duration as ``<hours>h <minutes>m``, rounded to the nearest minute.
+
+    Rounds the total minutes first, so 44.9 minutes is ``0h 45m`` and 59.6 minutes
+    is ``1h 00m``.
+    """
+    whole, minutes = divmod(round(hours * 60), 60)
+    return f"{whole}h {minutes:02d}m"
+
