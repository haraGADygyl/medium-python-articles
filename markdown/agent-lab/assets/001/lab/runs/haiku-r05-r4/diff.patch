 from math import exp
 
 from trailhead.elevation import counted_changes
@@ -7,6 +8,13 @@ from trailhead.track import Track
 
 FLAT_SPEED_KMH = 5.0
 CLIMB_M_PER_HOUR = 600.0
+PACES = ("naismith", "tobler")
+
+
+def check_pace(pace: str) -> None:
+    """Raise ``ValueError`` unless ``pace`` names a known walking-time rule."""
+    if pace not in PACES:
+        raise ValueError(f"pace must be one of {', '.join(PACES)}, not {pace!r}")
 
 
 def naismith_hours(distance_km: float, ascent_m: float, fitness: float = 1.0) -> float:
@@ -31,15 +39,35 @@ def tobler_kmh(grade: float) -> float:
     return 6.0 * exp(-3.5 * abs(grade + 0.05))
 
 
-def leg_hours(track: Track, fitness: float = 1.0) -> list[float]:
-    """Naismith time for every leg.
+def leg_hours(track: Track, fitness: float = 1.0, pace: str = "naismith") -> list[float]:
+    """Walking time for every leg, by the rule named in ``pace``.
 
-    A leg's climb is the ascent the summary's rule credits to it
-    (`elevation.counted_changes` with the default threshold), so the legs of a
+    Under ``"naismith"`` a leg's climb is the ascent the summary's rule credits to
+    it (`elevation.counted_changes` with the default threshold), so the legs of a
     track add up to its summary time.
+
+    Under ``"tobler"`` a leg takes its length divided by ``tobler_kmh`` of its
+    grade, where grade is the raw elevation change over the horizontal length. A
+    zero-length leg takes no time.
     """
+    check_pace(pace)
+    if pace == "tobler":
+        return _tobler_leg_hours(track, fitness)
     climbs = [max(change, 0.0) for change in counted_changes([p.ele for p in track.points])]
     return [
         naismith_hours(km, climb, fitness)
         for km, climb in zip(track.leg_lengths_km(), climbs, strict=True)
     ]
+
+
+def _tobler_leg_hours(track: Track, fitness: float) -> list[float]:
+    if fitness <= 0:
+        raise ValueError("fitness must be positive")
+    hours: list[float] = []
+    for (a, b), km in zip(pairwise(track.points), track.leg_lengths_km(), strict=True):
+        if km == 0:
+            hours.append(0.0)
+            continue
+        grade = (b.ele - a.ele) / (km * 1000)
+        hours.append(km / tobler_kmh(grade) / fitness)
+    return hours
