diff --git a/tests/test_pace.py b/tests/test_pace.py
index 6aec825..7d64a9b 100644
--- a/tests/test_pace.py
+++ b/tests/test_pace.py
@@ -28,3 +28,14 @@ def test_leg_hours(make_track):
     climb, descent = leg_hours(track)
     assert climb == pytest.approx(1.11195 / 5 + 0.5, abs=1e-4)
     assert descent == pytest.approx(1.11195 / 5, abs=1e-4)
+
+
+def test_leg_hours_ignore_jitter_and_match_summary(make_track):
+    from trailhead.elevation import gain_and_loss
+    from trailhead.pace import naismith_hours
+
+    eles = [1000, 1001, 1000, 1001, 1000, 1001, 1000, 1010, 1000]
+    track = make_track(*[(0, 0.01 * i, e) for i, e in enumerate(eles)])
+    gain, _ = gain_and_loss(eles)
+    expected = naismith_hours(track.length_km(), gain)
+    assert sum(leg_hours(track)) == pytest.approx(expected)
