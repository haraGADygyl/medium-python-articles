+def leg_hours(
+    track: Track, fitness: float = 1.0, threshold: float = DEFAULT_THRESHOLD_M
+) -> list[float]:
+    """Naismith time for every leg, counting the climb credited to that leg.
+
+    Climb is the thresholded ascent from ``counted_changes``, the same ascent
+    the summary uses, so GPS jitter adds no time and the legs sum to the summary.
+    """
+    changes = counted_changes([point.ele for point in track.points], threshold)
     return [
