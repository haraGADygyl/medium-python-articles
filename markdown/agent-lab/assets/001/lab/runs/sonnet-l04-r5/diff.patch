+def filled_elevations(track: Track) -> list[float]:
+    """One elevation per point, in metres, with gaps filled in.
+
+    A point without an elevation takes that of the nearest earlier point that has one
+    or, if there is none, of the nearest later point.
+    """
+    known = [point.ele for point in track.points if point.ele is not None]
+    if not known:
+        raise ValueError("the track has no elevation data")
+    filled: list[float] = []
+    last = known[0]
+    for point in track.points:
+        if point.ele is not None:
+            last = point.ele
+        filled.append(last)
+    return filled
+
+
 def highest_and_lowest(track: Track) -> tuple[float, float]:
     """Highest and lowest elevation on the track, in metres."""
-    elevations = [point.ele for point in track.points]
+    elevations = filled_elevations(track)
     return max(elevations), min(elevations)
 
 
@@ -59,8 +77,9 @@ def steepest_grade(track: Track) -> float:
     zero length (repeated points) are skipped.
     """
     steepest = 0.0
-    for (a, b), km in zip(pairwise(track.points), track.leg_lengths_km(), strict=True):
+    elevations = filled_elevations(track)
+    for (a, b), km in zip(pairwise(elevations), track.leg_lengths_km(), strict=True):
         if km == 0:
             continue
-        steepest = max(steepest, abs(b.ele - a.ele) / (km * 1000) * 100)
+        steepest = max(steepest, abs(b - a) / (km * 1000) * 100)
     return round(steepest, 1)
