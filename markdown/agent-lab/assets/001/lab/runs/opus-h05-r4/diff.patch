 """Walking-time estimates."""
 
-from itertools import pairwise
 from math import exp
 
+from trailhead.elevation import DEFAULT_THRESHOLD_M, counted_changes
 from trailhead.track import Track
 
 FLAT_SPEED_KMH = 5.0
@@ -31,9 +31,16 @@ def tobler_kmh(grade: float) -> float:
     return 6.0 * exp(-3.5 * abs(grade + 0.05))
 
 
-def leg_hours(track: Track, fitness: float = 1.0) -> list[float]:
-    """Naismith time for every leg, counting the leg's own climb."""
+def leg_hours(
+    track: Track, fitness: float = 1.0, threshold: float = DEFAULT_THRESHOLD_M
+) -> list[float]:
+    """Naismith time for every leg.
+
+    A leg's climb is the ascent ``elevation.counted_changes`` credits to it, the same
+    rule the summary uses, so the legs add up to the summary time.
+    """
+    climbs = counted_changes([point.ele for point in track.points], threshold)
     return [
-        naismith_hours(km, max(b.ele - a.ele, 0.0), fitness)
-        for (a, b), km in zip(pairwise(track.points), track.leg_lengths_km(), strict=True)
+        naismith_hours(km, max(climb, 0.0), fitness)
+        for climb, km in zip(climbs, track.leg_lengths_km(), strict=True)
     ]
