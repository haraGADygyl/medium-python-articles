+def test_jitter_is_not_counted_per_leg(make_track):
+    # Points wobble by +/-1 m (2 m swings, under the 3 m threshold) around a flat
+    # line. The summary's rule ignores that jitter, so the plan must not add up
+    # each leg's raw rise instead.
+    wobble = [1.0, -1.0] * 20
+    track = make_track(*[(0, index * 0.001, 1000 + w) for index, w in enumerate(wobble)])
+    total = sum(hours for *_, hours in split_days(track, max_hours_per_day=100))
+    assert total == pytest.approx(track.length_km() / 5, abs=0.01)
+
+
 def test_invalid_limit(five_flat_hours):
     with pytest.raises(ValueError):
         split_days(five_flat_hours, max_hours_per_day=0)
