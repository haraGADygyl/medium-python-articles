+def check_pace(pace: str) -> None:
+    """Raise ``ValueError`` unless ``pace`` is one of `PACES`."""
+    if pace not in PACES:
+        raise ValueError(f"pace must be one of {', '.join(PACES)}, not {pace!r}")
 
-    A leg's climb is the ascent the summary's rule credits to it
+
+def tobler_hours(distance_km: float, rise_m: float, fitness: float = 1.0) -> float:
+    """Time for one leg by Tobler's hiking function.
+
+    ``rise_m`` is the leg's elevation change (negative downhill). The grade is
+    ``rise_m`` over the horizontal length in metres; a zero-length leg takes no time.
+    ``fitness`` divides the result as it does for `naismith_hours`.
+    """
+    if distance_km < 0:
+        raise ValueError("distance must not be negative")
+    if fitness <= 0:
+        raise ValueError("fitness must be positive")
+    if distance_km == 0:
+        return 0.0
+    grade = rise_m / (distance_km * 1000)
+    return distance_km / tobler_kmh(grade) / fitness
+
+
+def leg_hours(track: Track, fitness: float = 1.0, pace: str = DEFAULT_PACE) -> list[float]:
+    """Walking time for every leg, by Naismith's rule (the default) or Tobler's function.
+
+    Under Naismith, a leg's climb is the ascent the summary's rule credits to it
     (`elevation.counted_changes` with the default threshold), so the legs of a
-    track add up to its summary time.
+    track add up to its summary time. Under Tobler, a leg's grade is its raw
+    elevation change over its horizontal length.
     """
+    check_pace(pace)
+    lengths = track.leg_lengths_km()
+    if pace == "tobler":
+        return [
+            tobler_hours(km, b.ele - a.ele, fitness)
+            for km, (a, b) in zip(lengths, pairwise(track.points), strict=True)
+        ]
     climbs = [max(change, 0.0) for change in counted_changes([p.ele for p in track.points])]
-    return [
-        naismith_hours(km, climb, fitness)
-        for km, climb in zip(track.leg_lengths_km(), climbs, strict=True)
-    ]
+    return [naismith_hours(km, climb, fitness) for km, climb in zip(lengths, climbs, strict=True)]
