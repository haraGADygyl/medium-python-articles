diff --git a/src/trailhead/track.py b/src/trailhead/track.py
index 48670aa..571196a 100644
--- a/src/trailhead/track.py
+++ b/src/trailhead/track.py
@@ -33,6 +33,23 @@ class Track:
     def length_km(self) -> float:
         return sum(self.leg_lengths_km())
 
+    def elevations(self) -> list[float]:
+        """Elevation of every point in metres, with gaps filled as the README describes.
+
+        A point without an elevation takes the elevation of the nearest earlier point
+        that has one or, if there is none, of the nearest later point.
+        """
+        known = [point.ele for point in self.points if point.ele is not None]
+        if not known:
+            raise TrackError("no point in the track has an elevation")
+        filled: list[float] = []
+        last = known[0]
+        for point in self.points:
+            if point.ele is not None:
+                last = point.ele
+            filled.append(last)
+        return filled
+
 
 def parse_track(text: str, default_name: str | None = None) -> Track:
     """Parse a track; see the README for the format."""
