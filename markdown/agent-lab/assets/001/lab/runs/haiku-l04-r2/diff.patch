-from trailhead.track import Track
+from trailhead.track import Track, TrackError
 
 DEFAULT_THRESHOLD_M = 3.0
 
 
+def filled_elevations(track: Track) -> list[float]:
+    """Elevation of every point in metres, with gaps filled as the README describes.
+
+    A missing elevation takes the nearest earlier known one or, if there is none,
+    the nearest later one.
+    """
+    raw = [point.ele for point in track.points]
+    first_known = next((ele for ele in raw if ele is not None), None)
+    if first_known is None:
+        raise TrackError("no point has an elevation")
+    filled: list[float] = []
+    last = first_known
+    for ele in raw:
+        if ele is not None:
+            last = ele
+        filled.append(last)
+    return filled
+
+
 def counted_changes(
     elevations: Sequence[float], threshold: float = DEFAULT_THRESHOLD_M
 ) -> list[float]:
