+from math import pi
+
+import pytest
+
+from trailhead.pace import leg_hours
+from trailhead.plan import DEFAULT_MAX_HOURS, describe_plan, split_days
+from trailhead.report import summarise
+from trailhead.track import Point, Track
+
+KM_PER_DEGREE = 6371.0088 * pi / 180  # along the equator
+
+
+def equator_track(leg_hours_flat: list[float], elevations: list[float] | None = None) -> Track:
+    """A track along the equator whose legs take the given hours on the flat (5 km/h)."""
+    lons = [0.0]
+    for hours in leg_hours_flat:
+        lons.append(lons[-1] + hours * 5 / KM_PER_DEGREE)
+    if elevations is None:
+        elevations = [1000.0] * len(lons)
+    return Track("test", [Point(0.0, lon, ele) for lon, ele in zip(lons, elevations, strict=True)])
+
+
+def check_shape(days, track):
+    """Days count from 1, start at point 0, end at the last point and share boundaries."""
+    assert [day for day, *_ in days] == list(range(1, len(days) + 1))
+    assert days[0][1] == 0
+    assert days[-1][2] == len(track.points) - 1
+    for (_, _, last, _), (_, first, _, _) in zip(days, days[1:], strict=False):
+        assert first == last
+    for _, first, last, _ in days:
+        assert first < last
+
+
+# --- split_days -----------------------------------------------------------------
+
+
+def test_default_limit_is_seven_hours():
+    assert DEFAULT_MAX_HOURS == 7.0
+
+
+def test_short_walk_is_a_single_day():
+    track = equator_track([1, 1, 1])
+    assert split_days(track) == [(1, 0, 3, 3.0)]
+
+
+def test_two_point_track_is_one_day():
+    track = equator_track([2])
+    assert split_days(track) == [(1, 0, 1, 2.0)]
+
+
+def test_default_limit_splits_the_walk():
+    # Six legs of 1.5 h: four fit in 7 h (6 h), the fifth would make 7.5 h.
+    track = equator_track([1.5] * 6)
+    assert split_days(track) == [(1, 0, 4, 6.0), (2, 4, 6, 3.0)]
+
+
+def test_custom_limit():
+    track = equator_track([1] * 10)
+    assert split_days(track, max_hours_per_day=3.5) == [
+        (1, 0, 3, 3.0),
+        (2, 3, 6, 3.0),
+        (3, 6, 9, 3.0),
+        (4, 9, 10, 1.0),
+    ]
+
+
+def test_limit_as_keyword_and_positional_agree():
+    track = equator_track([1] * 10)
+    assert split_days(track, 3.5) == split_days(track, max_hours_per_day=3.5)
+
+
+def test_days_never_go_over_the_limit():
+    pattern = [0.4, 1.3, 2.2, 0.7, 1.9, 0.1, 2.6, 1.1, 0.5, 3.0, 1.6, 0.9]
+    track = equator_track(pattern)
+    for limit in (3.1, 4.0, 5.5, 7.0, 9.25):
+        days = split_days(track, limit)
+        check_shape(days, track)
+        assert all(hours <= limit for *_, hours in days)
+
+
+def test_days_are_greedy():
+    # A day ends only when the next leg would push it over the limit.
+    pattern = [0.4, 1.3, 2.2, 0.7, 1.9, 0.1, 2.6, 1.1, 0.5, 3.0, 1.6, 0.9]
+    track = equator_track(pattern)
+    legs = leg_hours(track)
+    limit = 4.0
+    days = split_days(track, limit)
+    for _, first, last, _ in days[:-1]:
+        assert sum(legs[first : last + 1]) > limit
+
+
+def test_leg_longer_than_the_limit_is_a_day_by_itself():
+    track = equator_track([1, 10, 1])
+    assert split_days(track) == [(1, 0, 1, 1.0), (2, 1, 2, 10.0), (3, 2, 3, 1.0)]
+
+
+def test_long_first_and_last_legs():
+    track = equator_track([9, 1, 1, 8])
+    assert split_days(track) == [(1, 0, 1, 9.0), (2, 1, 3, 2.0), (3, 3, 4, 8.0)]
+
+
+def test_consecutive_long_legs_each_get_a_day():
+    track = equator_track([8, 8])
+    assert split_days(track) == [(1, 0, 1, 8.0), (2, 1, 2, 8.0)]
+
+
+def test_hours_are_rounded_to_hundredths():
+    track = equator_track([1 / 3, 1 / 3])
+    ((_, _, _, hours),) = split_days(track)
+    assert hours == 0.67
+
+
+def test_ascent_is_timed_by_naismith():
+    # 1 h on the flat plus 600 m of climbing = 2 h.
+    track = equator_track([1], elevations=[1000, 1600])
+    assert split_days(track) == [(1, 0, 1, 2.0)]
+
+
+def test_descent_adds_nothing():
+    track = equator_track([1], elevations=[1600, 1000])
+    assert split_days(track) == [(1, 0, 1, 1.0)]
+
+
+def test_climb_pushes_a_leg_into_the_next_day():
+    # Flat, each leg is 1 h; the 600 m climb on the third leg makes it 2 h.
+    track = equator_track([1, 1, 1, 1], elevations=[1000, 1000, 1000, 1600, 1600])
+    assert split_days(track, max_hours_per_day=3.5) == [(1, 0, 2, 2.0), (2, 2, 4, 3.0)]
+
+
+def test_jitter_below_the_threshold_adds_no_time():
+    elevations = [1000, 1001, 999, 1002, 1000, 1001]
+    track = equator_track([1] * 5, elevations=elevations)
+    assert split_days(track) == [(1, 0, 5, 5.0)]
+
+
+def test_slow_climb_in_small_steps_still_counts():
+    # 300 m in 1 m steps over 300 legs of 0.01 h: 3 h walking + 0.5 h climbing.
+    elevations = [1000.0 + i for i in range(301)]
+    track = equator_track([0.01] * 300, elevations=elevations)
+    ((_, _, _, hours),) = split_days(track, max_hours_per_day=10)
+    assert hours == pytest.approx(3.5, abs=0.01)
+
+
+@pytest.mark.parametrize("fitness", [1.0, 0.8, 1.25, 2.0])
+@pytest.mark.parametrize("limit", [2.0, 4.5, 7.0, 100.0])
+def test_days_add_up_to_the_summary_time(fitness, limit):
+    # Rolling terrain with jitter, small steps and big climbs and descents.
+    elevations = [1000, 1002, 1001, 1040, 1041, 1043, 1046, 1010, 1011, 1300, 1299, 1150, 1500]
+    pattern = [0.3, 0.6, 1.1, 0.2, 0.2, 0.9, 1.4, 0.5, 2.1, 0.3, 1.2, 1.7]
+    track = equator_track(pattern, elevations=elevations)
+    days = split_days(track, limit, fitness)
+    total = sum(hours for *_, hours in days)
+    # Each day is rounded to 0.01 h, so allow half of that per day.
+    assert total == pytest.approx(summarise(track, fitness).hours, abs=0.005 * len(days) + 1e-3)
+
+
+def test_fitness_divides_the_time():
+    track = equator_track([1.5] * 6)
+    assert split_days(track, fitness=2.0) == [(1, 0, 6, 4.5)]
+    assert split_days(track, fitness=0.5) == [
+        (1, 0, 2, 6.0),
+        (2, 2, 4, 6.0),
+        (3, 4, 6, 6.0),
+    ]
+
+
+def test_fitness_matches_the_summary():
+    track = equator_track([1, 2, 1], elevations=[1000, 1300, 1300, 1600])
+    for fitness in (0.75, 1.0, 1.2):
+        ((_, _, _, hours),) = split_days(track, 100, fitness)
+        assert hours == pytest.approx(summarise(track, fitness).hours, abs=0.005)
+
+
+@pytest.mark.parametrize("limit", [0, -1, -7.0])
+def test_limit_must_be_positive(limit):
+    with pytest.raises(ValueError):
+        split_days(equator_track([1]), limit)
+
+
+@pytest.mark.parametrize("fitness", [0, -1.0])
+def test_fitness_must_be_positive(fitness):
+    with pytest.raises(ValueError):
+        split_days(equator_track([1]), fitness=fitness)
+
+
+def test_repeated_points_are_handled():
+    track = equator_track([1, 0, 1, 0, 0, 1])
+    days = split_days(track, 2.5)
+    check_shape(days, track)
+    assert sum(hours for *_, hours in days) == pytest.approx(3.0)
+
+
+# --- describe_plan --------------------------------------------------------------
+
+
+def test_describe_plan_docstring_example():
+    assert describe_plan([(2, 14, 31, 6 + 5 / 60)]) == ["Day 2: points 14-31, 6h 05m"]
+
+
+@pytest.mark.parametrize(
+    ("hours", "shown"),
+    [
+        (5 + 7 / 60, "5h 07m"),
+        (0.75, "0h 45m"),
+        (12.0, "12h 00m"),
+        (0.0, "0h 00m"),
+        (1.0, "1h 00m"),
+        (2.99, "2h 59m"),  # 179.4 minutes rounds down
+        (0.999, "1h 00m"),  # 59.94 minutes rounds up to the next hour
+        (3.6, "3h 36m"),
+        (25.5, "25h 30m"),
+    ],
+)
+def test_durations_are_rounded_to_the_minute(hours, shown):
+    assert describe_plan([(1, 0, 1, hours)]) == [f"Day 1: points 0-1, {shown}"]
+
+
+def test_describe_plan_one_line_per_day_in_order():
+    days = [(1, 0, 4, 6.0), (2, 4, 9, 6.5), (3, 9, 12, 2.25)]
+    assert describe_plan(days) == [
+        "Day 1: points 0-4, 6h 00m",
+        "Day 2: points 4-9, 6h 30m",
+        "Day 3: points 9-12, 2h 15m",
+    ]
+
+
+def test_describe_plan_of_nothing_is_empty():
+    assert describe_plan([]) == []
+
+
+def test_describe_a_split_track():
+    track = equator_track([1, 10, 1])
+    assert describe_plan(split_days(track)) == [
+        "Day 1: points 0-1, 1h 00m",
+        "Day 2: points 1-2, 10h 00m",
+        "Day 3: points 2-3, 1h 00m",
+    ]
