+def test_steepest_grade_is_a_percentage(make_track):
+    track = make_track(
+        (0, 0, 500),
+        (HUNDRED_M_LAT, 0, 505),
+        (2 * HUNDRED_M_LAT, 0, 523),
+        (2 * HUNDRED_M_LAT, 0, 523),
+        (3 * HUNDRED_M_LAT, 0, 513),
+    )
+    assert steepest_grade(track) == 18.0
+
