diff --git a/tests/test_pace.py b/tests/test_pace.py
index 6aec825..9ff3e77 100644
--- a/tests/test_pace.py
+++ b/tests/test_pace.py
@@ -28,3 +28,38 @@ def test_leg_hours(make_track):
     climb, descent = leg_hours(track)
     assert climb == pytest.approx(1.11195 / 5 + 0.5, abs=1e-4)
     assert descent == pytest.approx(1.11195 / 5, abs=1e-4)
+
+
+def test_tobler_leg_uses_its_grade(make_track):
+    # Leg one climbs 300 m over 1.11195 km; leg two drops 300 m over the same distance.
+    track = make_track((0, 0, 1000), (0, 0.01, 1300), (0, 0.02, 1000))
+    up, down = leg_hours(track, pace="tobler")
+    assert up == pytest.approx(1.11195 / tobler_kmh(300 / 1111.95), abs=1e-4)
+    assert down == pytest.approx(1.11195 / tobler_kmh(-300 / 1111.95), abs=1e-4)
+    assert down < up
+
+
+def test_tobler_zero_length_leg_takes_no_time(make_track):
+    track = make_track((0, 0, 0), (0, 0, 0), (0, 0.01, 0))
+    first, second = leg_hours(track, pace="tobler")
+    assert first == 0.0
+    assert second > 0
+
+
+def test_tobler_fitness_divides_time(make_track):
+    track = make_track((0, 0, 0), (0, 0.01, 50))
+    assert leg_hours(track, fitness=2.0, pace="tobler")[0] == pytest.approx(
+        leg_hours(track, pace="tobler")[0] / 2
+    )
+
+
+def test_naismith_is_the_default(make_track):
+    track = make_track((0, 0, 1000), (0, 0.01, 1300))
+    assert leg_hours(track) == leg_hours(track, pace="naismith")
+
+
+@pytest.mark.parametrize("pace", ["Tobler", "", "minetti"])
+def test_unknown_pace_is_an_error(make_track, pace):
+    track = make_track((0, 0, 0), (0, 0.01, 0))
+    with pytest.raises(ValueError):
+        leg_hours(track, pace=pace)
