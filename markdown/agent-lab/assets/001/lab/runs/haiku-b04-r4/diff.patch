diff --git a/src/trailhead/track.py b/src/trailhead/track.py
index e147dce..e2f9d7f 100644
--- a/src/trailhead/track.py
+++ b/src/trailhead/track.py
@@ -36,6 +36,9 @@ class Track:
 
 def parse_track(text: str, default_name: str | None = None) -> Track:
     """Parse a track; see the README for the format."""
+    # Editors and Garmin exports often prepend a UTF-8 byte order mark, which
+    # str.strip() does not remove, so it would otherwise stick to the header.
+    text = text.removeprefix("﻿")
     name = default_name or "unnamed"
     scale = 1.0
     points: list[Point] = []
diff --git a/tests/test_track.py b/tests/test_track.py
index ba1bbad..691b329 100644
--- a/tests/test_track.py
+++ b/tests/test_track.py
@@ -30,6 +30,18 @@ def test_default_name_comes_from_the_file(write_track):
     assert load_track(path).name == "vihren"
 
 
+def test_byte_order_mark_before_header_is_ignored():
+    track = parse_track("﻿lat,lon,ele\r\n0,0,5\r\n0,0.01,7\r\n")
+    assert [point.ele for point in track.points] == [5, 7]
+
+
+def test_file_with_bom_and_crlf_loads(write_track):
+    path = write_track("﻿lat,lon,ele\r\n0,0,5\r\n0,0.01,7\r\n", filename="garmin-export.csv")
+    track = load_track(path)
+    assert track.name == "garmin-export"
+    assert len(track.points) == 2
+
+
 def test_bad_header():
     with pytest.raises(TrackError, match="line 1:"):
         parse_track("latitude,longitude,elevation\n0,0,0\n0,1,0\n")
