+from itertools import pairwise
+
+import pytest
+
+from trailhead.plan import DEFAULT_MAX_HOURS, describe_plan, split_days
+from trailhead.report import summarise
+
+
+def climbing_track(make_track, *climbs_m: float):
+    """A track whose legs have zero length and climb the given metres.
+
+    By Naismith's rule each leg then takes exactly ``climb / 600`` hours, which
+    makes day boundaries easy to reason about.
+    """
+    elevations = [1000.0]
+    for climb in climbs_m:
+        elevations.append(elevations[-1] + climb)
+    return make_track(*((45.0, 7.0, ele) for ele in elevations))
+
+
+def hours(days):
+    return [day[3] for day in days]
+
+
+# --- split_days -----------------------------------------------------------
+
+
+def test_default_limit_is_seven_hours():
+    assert DEFAULT_MAX_HOURS == 7.0
+
+
+def test_short_walk_is_a_single_day(make_track):
+    track = climbing_track(make_track, 600, 600)
+    assert split_days(track) == [(1, 0, 2, 2.0)]
+
+
+def test_days_split_at_the_limit_and_share_boundary_points(make_track):
+    # Five legs of one hour each, at most two hours a day.
+    track = climbing_track(make_track, 600, 600, 600, 600, 600)
+    assert split_days(track, max_hours_per_day=2) == [
+        (1, 0, 2, 2.0),
+        (2, 2, 4, 2.0),
+        (3, 4, 5, 1.0),
+    ]
+
+
+def test_default_limit_is_used(make_track):
+    # Nine one-hour legs: 7 hours on day one, 2 on day two.
+    track = climbing_track(make_track, *[600] * 9)
+    assert split_days(track) == [(1, 0, 7, 7.0), (2, 7, 9, 2.0)]
+
+
+def test_a_day_may_end_exactly_on_the_limit(make_track):
+    # 1.5 + 1.5 = 3.0 hours exactly; the third leg starts a new day.
+    track = climbing_track(make_track, 900, 900, 900)
+    assert split_days(track, max_hours_per_day=3) == [(1, 0, 2, 3.0), (2, 2, 3, 1.5)]
+
+
+def test_days_are_numbered_from_one_consecutively(make_track):
+    track = climbing_track(make_track, *[600] * 6)
+    days = split_days(track, max_hours_per_day=1)
+    assert [day[0] for day in days] == [1, 2, 3, 4, 5, 6]
+    assert [(day[1], day[2]) for day in days] == [(i, i + 1) for i in range(6)]
+
+
+def test_plan_covers_the_whole_track_without_gaps(make_track):
+    track = climbing_track(make_track, 300, 700, 200, 900, 100, 400, 800, 50)
+    days = split_days(track, max_hours_per_day=2)
+    assert days[0][1] == 0
+    assert days[-1][2] == len(track.points) - 1
+    for previous, following in pairwise(days):
+        assert following[1] == previous[2]
+        assert following[0] == previous[0] + 1
+
+
+@pytest.mark.parametrize("limit", [1.0, 1.5, 2.0, 2.75, 4.0])
+def test_no_day_goes_over_the_limit_when_every_leg_fits(make_track, limit):
+    track = climbing_track(make_track, 300, 420, 120, 540, 60, 240, 480, 30, 360)
+    days = split_days(track, max_hours_per_day=limit)
+    assert all(day[3] <= limit + 1e-9 for day in days)
+
+
+def test_days_are_as_long_as_the_limit_allows(make_track):
+    # Greedy grouping: a day only ends when the next leg would not fit.
+    track = climbing_track(make_track, 300, 300, 300, 300, 300)  # 0.5 h legs
+    assert hours(split_days(track, max_hours_per_day=1.2)) == [1.0, 1.0, 0.5]
+
+
+def test_a_leg_over_the_limit_is_a_day_by_itself(make_track):
+    # Legs: 1 h, 4 h, 1 h with a 2 hour limit.
+    track = climbing_track(make_track, 600, 2400, 600)
+    assert split_days(track, max_hours_per_day=2) == [
+        (1, 0, 1, 1.0),
+        (2, 1, 2, 4.0),
+        (3, 2, 3, 1.0),
+    ]
+
+
+def test_a_long_first_leg_is_a_day_by_itself(make_track):
+    track = climbing_track(make_track, 2400, 600, 600)
+    assert split_days(track, max_hours_per_day=2) == [(1, 0, 1, 4.0), (2, 1, 3, 2.0)]
+
+
+def test_a_long_last_leg_is_a_day_by_itself(make_track):
+    track = climbing_track(make_track, 600, 600, 2400)
+    assert split_days(track, max_hours_per_day=2) == [(1, 0, 2, 2.0), (2, 2, 3, 4.0)]
+
+
+def test_consecutive_long_legs_are_separate_days(make_track):
+    track = climbing_track(make_track, 1800, 1800)
+    assert split_days(track, max_hours_per_day=2) == [(1, 0, 1, 3.0), (2, 1, 2, 3.0)]
+
+
+def test_descent_adds_no_time(make_track):
+    track = make_track((45, 7, 2000), (45, 7, 2600), (45, 7, 1400), (45, 7, 2000))
+    assert split_days(track) == [(1, 0, 3, 2.0)]
+
+
+def test_flat_legs_are_timed_at_five_km_an_hour(make_track):
+    # Along the equator 0.1 degree of longitude is about 11.1195 km.
+    track = make_track((0, 0, 500), (0, 0.1, 500), (0, 0.2, 500))
+    days = split_days(track, max_hours_per_day=3)
+    assert [(day[0], day[1], day[2]) for day in days] == [(1, 0, 1), (2, 1, 2)]
+    assert hours(days) == pytest.approx([2.22, 2.22])
+
+
+def test_hours_are_rounded_to_hundredths(make_track):
+    track = climbing_track(make_track, 100)  # 1/6 h = 0.1666...
+    assert split_days(track) == [(1, 0, 1, 0.17)]
+
+
+def test_fitness_divides_the_time(make_track):
+    track = climbing_track(make_track, 600, 600, 600, 600)
+    assert split_days(track, max_hours_per_day=2, fitness=2) == [(1, 0, 4, 2.0)]
+    assert split_days(track, max_hours_per_day=2, fitness=0.5) == [
+        (1, 0, 1, 2.0),
+        (2, 1, 2, 2.0),
+        (3, 2, 3, 2.0),
+        (4, 3, 4, 2.0),
+    ]
+
+
+def test_leg_climb_uses_the_summary_threshold(make_track):
+    # Jitter of a metre either way counts as no climb at all.
+    jitter = make_track(*((45, 7, 1000 + (i % 2)) for i in range(20)))
+    assert split_days(jitter) == [(1, 0, 19, 0.0)]
+    # A 300 m climb in 1 m steps still counts as 300 m: half an hour.
+    steps = make_track(*((45, 7, 1000 + i) for i in range(301)))
+    assert split_days(steps) == [(1, 0, 300, 0.5)]
+
+
+RIDGE = (
+    (42.2031, 23.3205, 2140),
+    (42.2049, 23.3188, 2196),
+    (42.2060, 23.3150, 2198),
+    (42.2081, 23.3121, 2251),
+    (42.2090, 23.3090, 2249.5),
+    (42.2112, 23.3060, 2320),
+    (42.2140, 23.3031, 2301),
+    (42.2155, 23.2990, 2402),
+    (42.2170, 23.2950, 2400),
+    (42.2190, 23.2911, 2465),
+    (42.2200, 23.2870, 2380),
+    (42.2230, 23.2840, 2420),
+)
+
+
+@pytest.mark.parametrize("fitness", [0.8, 1.0, 1.25])
+@pytest.mark.parametrize("limit", [0.3, 0.6, 1.0, 7.0])
+def test_days_add_up_to_the_summary_time(make_track, fitness, limit):
+    track = make_track(*RIDGE)
+    days = split_days(track, max_hours_per_day=limit, fitness=fitness)
+    expected = summarise(track, fitness=fitness).hours
+    assert sum(hours(days)) == pytest.approx(expected, abs=0.005 * len(days) + 1e-6)
+
+
+def test_two_point_track(make_track):
+    track = climbing_track(make_track, 1200)
+    assert split_days(track, max_hours_per_day=1) == [(1, 0, 1, 2.0)]
+
+
+@pytest.mark.parametrize("limit", [0, -1, -0.5])
+def test_non_positive_limit_is_an_error(make_track, limit):
+    track = climbing_track(make_track, 600)
+    with pytest.raises(ValueError):
+        split_days(track, max_hours_per_day=limit)
+
+
+@pytest.mark.parametrize("fitness", [0, -1])
+def test_non_positive_fitness_is_an_error(make_track, fitness):
+    track = climbing_track(make_track, 600)
+    with pytest.raises(ValueError):
+        split_days(track, fitness=fitness)
+
+
+# --- describe_plan --------------------------------------------------------
+
+
+def test_describe_plan_docstring_example():
+    assert describe_plan([(2, 14, 31, 6 + 5 / 60)]) == ["Day 2: points 14-31, 6h 05m"]
+
+
+def test_describe_plan_one_line_per_day():
+    assert describe_plan([(1, 0, 7, 7.0), (2, 7, 9, 2.0)]) == [
+        "Day 1: points 0-7, 7h 00m",
+        "Day 2: points 7-9, 2h 00m",
+    ]
+
+
+def test_describe_empty_plan():
+    assert describe_plan([]) == []
+
+
+@pytest.mark.parametrize(
+    ("hours_", "shown"),
+    [
+        (0.75, "0h 45m"),
+        (12.0, "12h 00m"),
+        (5 + 7 / 60, "5h 07m"),
+        (0.0, "0h 00m"),
+        (1.99, "1h 59m"),  # 119.4 minutes rounds down
+        (1.995, "2h 00m"),  # 119.7 minutes rounds up into the next hour
+        (0.01, "0h 01m"),  # 0.6 minutes rounds up
+    ],
+)
+def test_describe_plan_formats_durations(hours_, shown):
+    assert describe_plan([(1, 0, 1, hours_)]) == [f"Day 1: points 0-1, {shown}"]
+
+
+def test_describe_plan_of_a_split_track(make_track):
+    track = climbing_track(make_track, 600, 600, 600, 2400)
+    assert describe_plan(split_days(track, max_hours_per_day=2.5)) == [
+        "Day 1: points 0-2, 2h 00m",
+        "Day 2: points 2-3, 1h 00m",
+        "Day 3: points 3-4, 4h 00m",
+    ]
