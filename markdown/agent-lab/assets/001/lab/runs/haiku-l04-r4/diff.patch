diff --git a/src/trailhead/track.py b/src/trailhead/track.py
index 48670aa..074a035 100644
--- a/src/trailhead/track.py
+++ b/src/trailhead/track.py
@@ -26,6 +26,24 @@ class Track:
     name: str
     points: list[Point] = field(default_factory=list)
 
+    def elevations(self) -> list[float]:
+        """Elevation of every point in metres, with the gaps (``ele=None``) filled in.
+
+        A missing elevation takes that of the nearest earlier point that has one or,
+        if there is none, of the nearest later point. Raises ``ValueError`` when no
+        point has an elevation at all.
+        """
+        known = [point.ele for point in self.points if point.ele is not None]
+        if not known:
+            raise ValueError(f"track {self.name!r} has no elevations")
+        filled: list[float] = []
+        last = known[0]
+        for point in self.points:
+            if point.ele is not None:
+                last = point.ele
+            filled.append(last)
+        return filled
+
     def leg_lengths_km(self) -> list[float]:
         """Length of each leg, the stretch between two consecutive points."""
         return [haversine_km(a.lat, a.lon, b.lat, b.lon) for a, b in pairwise(self.points)]
