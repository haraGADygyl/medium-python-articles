+def test_file_with_utf8_byte_order_mark(tmp_path):
+    # Garmin exports start with a UTF-8 BOM; it must not hide the header.
+    path = tmp_path / "garmin-export.csv"
+    path.write_bytes(b"\xef\xbb\xbflat,lon,ele\r\n42.2031,23.3205,2140\r\n42.2049,23.3188,2196\r\n")
+    track = load_track(path)
+    assert track.name == "garmin-export"
+    assert [point.ele for point in track.points] == [2140, 2196]
+
+
 def test_bad_header():
     with pytest.raises(TrackError, match="line 1:"):
         parse_track("latitude,longitude,elevation\n0,0,0\n0,1,0\n")
