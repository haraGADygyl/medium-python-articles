 def load_track(path: str | Path) -> Track:
-    """Read a track file; without a ``# name:`` line the track is named after the file."""
+    """Read a track file; without a ``# name:`` line the track is named after the file.
+
+    ``utf-8-sig`` is used so that a byte-order mark, which some exporters (e.g. Garmin
