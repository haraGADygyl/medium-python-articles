+from math import exp
+
+import pytest
+
+from trailhead.pace import leg_hours, naismith_hours, tobler_kmh
+from trailhead.report import summarise
+
+# One degree of longitude along the equator, in km, on the README's sphere.
+KM_PER_DEGREE = 111.19508
+
+
+# --- naismith_hours ---------------------------------------------------------
+
+
+def test_flat_walking_is_five_km_per_hour():
+    assert naismith_hours(5, 0) == pytest.approx(1.0)
+    assert naismith_hours(12.5, 0) == pytest.approx(2.5)
+
+
+def test_six_hundred_metres_of_ascent_adds_an_hour():
+    assert naismith_hours(0, 600) == pytest.approx(1.0)
+    assert naismith_hours(10, 300) == pytest.approx(2.5)
+
+
+def test_nothing_to_walk_takes_no_time():
+    assert naismith_hours(0, 0) == 0.0
+
+
+def test_fitness_divides_the_time():
+    assert naismith_hours(10, 600, fitness=1.25) == pytest.approx(3.0 / 1.25)
+    assert naismith_hours(10, 600, fitness=0.8) == pytest.approx(3.0 / 0.8)
+
+
+def test_default_fitness_is_average():
+    assert naismith_hours(10, 600) == naismith_hours(10, 600, fitness=1.0)
+
+
+def test_times_are_not_rounded():
+    # 1 km on the flat is 12 minutes; 1 m of ascent is 6 seconds.
+    assert naismith_hours(1, 1) == pytest.approx(0.2 + 1 / 600)
+    assert naismith_hours(1, 0, fitness=3) == pytest.approx(0.2 / 3)
+
+
+@pytest.mark.parametrize("fitness", [0, -1, -0.5])
+def test_fitness_must_be_positive(fitness):
+    with pytest.raises(ValueError):
+        naismith_hours(10, 100, fitness=fitness)
+
+
+@pytest.mark.parametrize(("distance", "ascent"), [(-1, 0), (0, -1), (-5, -100)])
+def test_negative_distance_or_ascent_is_an_error(distance, ascent):
+    with pytest.raises(ValueError):
+        naismith_hours(distance, ascent)
+
+
+# --- tobler_kmh -------------------------------------------------------------
+
+
+def test_tobler_fastest_on_a_gentle_descent():
+    assert tobler_kmh(-0.05) == pytest.approx(6.0)
+    for grade in (-0.3, -0.1, -0.06, -0.04, 0.0, 0.1, 0.3):
+        assert tobler_kmh(grade) < 6.0
+
+
+def test_tobler_matches_the_formula():
+    for grade in (-0.5, -0.2, -0.05, 0.0, 0.1, 0.25, 1.0):
+        assert tobler_kmh(grade) == pytest.approx(6 * exp(-3.5 * abs(grade + 0.05)))
+
+
+def test_tobler_on_the_flat():
+    assert tobler_kmh(0.0) == pytest.approx(6 * exp(-0.175))  # about 5.04 km/h
+    assert tobler_kmh(0.0) == pytest.approx(5.037, abs=1e-3)
+
+
+def test_tobler_is_symmetric_about_the_fastest_grade():
+    for offset in (0.01, 0.1, 0.4):
+        assert tobler_kmh(-0.05 + offset) == pytest.approx(tobler_kmh(-0.05 - offset))
+
+
+def test_tobler_slows_as_the_slope_steepens():
+    climbs = [tobler_kmh(grade) for grade in (0.0, 0.1, 0.2, 0.5)]
+    descents = [tobler_kmh(grade) for grade in (-0.1, -0.2, -0.5)]
+    assert climbs == sorted(climbs, reverse=True)
+    assert descents == sorted(descents, reverse=True)
+
+
+def test_tobler_grade_is_rise_over_run_not_percent():
+    # A 10% climb is 0.1; passing 10 would mean a 1000% wall.
+    assert tobler_kmh(0.1) == pytest.approx(6 * exp(-3.5 * 0.15))
+    assert tobler_kmh(10) < 1e-6
+
+
+# --- leg_hours --------------------------------------------------------------
+
+
+def east(km: float) -> float:
+    """Longitude on the equator that is ``km`` east of 0."""
+    return km / KM_PER_DEGREE
+
+
+def test_one_time_per_leg(make_track):
+    track = make_track((0, 0, 0), (0, east(5), 0), (0, east(10), 0), (0, east(12.5), 0))
+    assert leg_hours(track) == pytest.approx([1.0, 1.0, 0.5], abs=1e-4)
+
+
+def test_leg_climb_adds_naismith_time(make_track):
+    track = make_track((0, 0, 1000), (0, east(5), 1600), (0, east(10), 1600))
+    assert leg_hours(track) == pytest.approx([2.0, 1.0], abs=1e-4)
+
+
+def test_descent_adds_nothing(make_track):
+    track = make_track((0, 0, 1600), (0, east(5), 1000))
+    assert leg_hours(track) == pytest.approx([1.0], abs=1e-4)
+
+
+def test_climb_below_threshold_is_ignored(make_track):
+    # 2 m of jitter is under the default 3 m threshold.
+    track = make_track((0, 0, 100), (0, east(5), 102), (0, east(10), 100))
+    assert leg_hours(track) == pytest.approx([1.0, 1.0], abs=1e-4)
+
+
+def test_small_steps_are_credited_to_the_leg_that_crosses_the_threshold(make_track):
+    # 1 m steps: nothing counts until the third leg, which gets the whole 3 m.
+    track = make_track(
+        (0, 0, 100),
+        (0, east(1), 101),
+        (0, east(2), 102),
+        (0, east(3), 103),
+    )
+    assert leg_hours(track) == pytest.approx([0.2, 0.2, 0.2 + 3 / 600], abs=1e-4)
+
+
+def test_repeated_point_is_a_zero_length_leg(make_track):
+    track = make_track((0, 0, 0), (0, 0, 0), (0, east(5), 0))
+    assert leg_hours(track) == pytest.approx([0.0, 1.0], abs=1e-4)
+
+
+def test_leg_hours_fitness_divides_every_leg(make_track):
+    track = make_track((0, 0, 1000), (0, east(5), 1600), (0, east(10), 1600))
+    base = leg_hours(track)
+    faster = leg_hours(track, fitness=1.25)
+    assert faster == pytest.approx([hours / 1.25 for hours in base])
+
+
+def test_leg_hours_rejects_non_positive_fitness(make_track):
+    track = make_track((0, 0, 0), (0, east(5), 0))
+    with pytest.raises(ValueError):
+        leg_hours(track, fitness=0)
+
+
+@pytest.mark.parametrize("fitness", [1.0, 1.25, 0.8])
+def test_legs_add_up_to_the_summary_time(make_track, fitness):
+    # A wiggly profile with jitter, small steps and real climbs and descents.
+    elevations = [1000, 1001, 999, 1002, 1004, 1050, 1049, 1120, 1100, 1095, 1240, 1238, 1000]
+    track = make_track(
+        *[(0.001 * index, east(0.7 * index), ele) for index, ele in enumerate(elevations)]
+    )
+    total = sum(leg_hours(track, fitness))
+    # The summary rounds ascent to 0.1 m, worth well under a second of walking.
+    assert total == pytest.approx(summarise(track, fitness).hours, abs=1e-4)
