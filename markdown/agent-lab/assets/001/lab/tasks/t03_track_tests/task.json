{
  "id": "t03",
  "tier": "tests",
  "title": "Write tests for track.py",
  "prompt": "`src/trailhead/track.py` has no tests. Write `tests/test_track.py` with pytest tests that check its behaviour as documented in the README and the docstrings. Don't change anything under `src/`.",
  "setup": [
    {
      "delete": "tests/test_track.py"
    }
  ],
  "grade": {
    "kind": "mutants",
    "test_file": "tests/test_track.py",
    "min_kills": 6,
    "mutants": [
      {
        "name": "feet not converted",
        "edits": [
          {
            "file": "src/trailhead/track.py",
            "old": "return Point(lat, lon, ele * scale)",
            "new": "return Point(lat, lon, ele)"
          }
        ]
      },
      {
        "name": "blank lines not skipped",
        "edits": [
          {
            "file": "src/trailhead/track.py",
            "old": "        if not line:\n            continue\n",
            "new": ""
          }
        ]
      },
      {
        "name": "range bounds exclusive",
        "edits": [
          {
            "file": "src/trailhead/track.py",
            "old": "if not -90 <= lat <= 90 or not -180 <= lon <= 180:",
            "new": "if not -90 < lat < 90 or not -180 < lon < 180:"
          }
        ]
      },
      {
        "name": "one point accepted",
        "edits": [
          {
            "file": "src/trailhead/track.py",
            "old": "if len(points) < 2:",
            "new": "if len(points) < 1:"
          }
        ]
      },
      {
        "name": "line numbers from 0",
        "edits": [
          {
            "file": "src/trailhead/track.py",
            "old": "enumerate(text.splitlines(), start=1)",
            "new": "enumerate(text.splitlines())"
          }
        ]
      },
      {
        "name": "unknown units accepted",
        "edits": [
          {
            "file": "src/trailhead/track.py",
            "old": "if value not in (\"m\", \"ft\"):",
            "new": "if not value:"
          }
        ]
      },
      {
        "name": "default name empty",
        "edits": [
          {
            "file": "src/trailhead/track.py",
            "old": "name = default_name or \"unnamed\"",
            "new": "name = default_name or \"\""
          }
        ]
      }
    ]
  },
  "reference": {
    "files": {
      "tests/test_track.py": "reference_test.py"
    }
  },
  "bad": {
    "kind": "happy-path tests only",
    "files": {
      "tests/test_track.py": "weak_test.py"
    }
  }
}
