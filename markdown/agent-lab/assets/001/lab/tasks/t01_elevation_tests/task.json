{
  "id": "t01",
  "tier": "tests",
  "title": "Write tests for elevation.py",
  "prompt": "`src/trailhead/elevation.py` has no tests. Write `tests/test_elevation.py` with pytest tests that check its behaviour as documented in the README and the docstrings. Don't change anything under `src/`.",
  "setup": [
    {
      "delete": "tests/test_elevation.py"
    }
  ],
  "grade": {
    "kind": "mutants",
    "test_file": "tests/test_elevation.py",
    "min_kills": 6,
    "mutants": [
      {
        "name": "gain threshold exclusive",
        "edits": [
          {
            "file": "src/trailhead/elevation.py",
            "old": "if change > 0 and change >= threshold:",
            "new": "if change > 0 and change > threshold:"
          }
        ]
      },
      {
        "name": "no hysteresis",
        "edits": [
          {
            "file": "src/trailhead/elevation.py",
            "old": "            loss -= change\n            reference = elevation\n    return",
            "new": "            loss -= change\n            reference = elevation\n        reference = elevation\n    return"
          }
        ]
      },
      {
        "name": "loss sign flipped",
        "edits": [
          {
            "file": "src/trailhead/elevation.py",
            "old": "            loss -= change\n",
            "new": "            loss += change\n"
          }
        ]
      },
      {
        "name": "default threshold 2 m",
        "edits": [
          {
            "file": "src/trailhead/elevation.py",
            "old": "DEFAULT_THRESHOLD_M = 3.0",
            "new": "DEFAULT_THRESHOLD_M = 2.0"
          }
        ]
      },
      {
        "name": "negative threshold clamped",
        "edits": [
          {
            "file": "src/trailhead/elevation.py",
            "old": "        raise ValueError(\"threshold must not be negative\")",
            "new": "        threshold = 0.0"
          }
        ]
      },
      {
        "name": "steepest ignores descents",
        "edits": [
          {
            "file": "src/trailhead/elevation.py",
            "old": "abs(b.ele - a.ele) / (km * 1000) * 100",
            "new": "(b.ele - a.ele) / (km * 1000) * 100"
          }
        ]
      },
      {
        "name": "zero-length legs not skipped",
        "edits": [
          {
            "file": "src/trailhead/elevation.py",
            "old": "        if km == 0:\n            continue\n",
            "new": ""
          }
        ]
      }
    ]
  },
  "reference": {
    "files": {
      "tests/test_elevation.py": "reference_test.py"
    }
  },
  "bad": {
    "kind": "happy-path tests only",
    "files": {
      "tests/test_elevation.py": "weak_test.py"
    }
  }
}
