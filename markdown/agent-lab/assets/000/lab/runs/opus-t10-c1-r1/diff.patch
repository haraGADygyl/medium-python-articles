+def _csv_id(text: str) -> int:
+    """Parse an observation id exactly, tolerating a trailing ".0".
+
+    Going through float would round ids above 2**53.
+    """
+    try:
+        return int(text)
+    except ValueError:
+        pass
+    try:
+        value = Decimal(text)
+    except InvalidOperation as exc:
+        raise ParseError(f"not an observation id: {text!r}") from exc
+    if not value.is_finite() or value != value.to_integral_value():
+        raise ParseError(f"not an observation id: {text!r}")
+    return int(value)
+
